    },
    {
      "id": "acdd2447-2707-4afe-8bae-150597fb339b",
      "name": "Matching Offers",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [224, 0],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "mode": "id", "value": "appaDSdZkAE9PGkjT" },
        "table": { "__rl": true, "mode": "id", "value": "tbljBgWrnIMZzkSAr", "cachedResultName": "Offers" },
        "filterByFormula": "={{ $json.body.category === \"Special Offers\" ? \"AND(OR({Is Cheapest}=1,{Cheaper By 5%+}=1),{Send Eligible}='Yes')\" : \"AND({Category}='\" + $json.body.category + \"',{Send Eligible}='Yes')\" }}",
        "returnAll": true,
        "options": { "fields": ["Public Product Description", "Public Spec", "Price Per Unit & Case", "Public Terms", "Stock Display"] }
      }
    },
    {
      "id": "39abb5ab-1340-461a-8bfc-05eac65f07e4",
      "name": "Compose Category Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const trigger = $('Category Request Webhook').first().json;\nconst body = trigger.body || {};\nconst category = body.category || 'Offers';\nconst toEmail = String(body.email||'').trim();\nconst note = String(body.note||'').trim();\n\nconst af = it => { const j=(it&&it.json)||{}; return { id:j.id, f:(j.fields||j) }; };\nconst offers = $input.all().map(af).filter(x=>x.id);\nconst LIMIT = 25;\nconst shown = offers.slice(0, LIMIT);\n\nlet lines = [];\nshown.forEach(({f})=>{\n  const name = f['Public Product Description']||'(product)';\n  const spec = f['Public Spec']||'';\n  const price = f['Price Per Unit & Case']||'';\n  const terms = f['Public Terms']||'';\n  const stock = f['Stock Display']||'';\n  lines.push(name + (spec?(' - '+spec):'') + (price?(' - '+price):'') + (terms?(' - '+terms):'') + (stock?(' ['+stock+']'):''));\n});\n\nconst bodyText = shown.length\n  ? ('Here are our current ' + category + ' offers:\\n\\n' + lines.join('\\n') + '\\n\\nInterested in any of these, or want to discuss quantities? Just reply to this email.\\n\\nBest regards,\\nAkay Irl Ltd')\n  : ('Thanks for your interest in ' + category + '. We do not have live offers in this category right now, but we have logged your request and someone will follow up.\\n\\nBest regards,\\nAkay Irl Ltd');\n\nreturn [{ json: {\n  toEmail,\n  category,\n  note,\n  subject: 'Your requested ' + category + ' offers',\n  bodyText,\n  matchCount: shown.length,\n  hasNote: Boolean(note)\n} }];\n"
      }
    },
    {
      "id": "5a4af140-080e-49d5-8f37-137fb3530380",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [672, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"Akay Irl Ltd <offers@akay.ie>\", to: [$json.toEmail], subject: $json.subject, text: $json.bodyText }) }}",
        "options": {}
      }
    },
    {
      "id": "2529a5b7-75dc-418a-a777-e482e0ca70ee",
      "name": "Has free-text note?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [896, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "leftValue": "={{ $(\"Compose Category Email\").first().json.hasNote }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "da1e4f0e-6579-45de-b70c-043e6a067bd2",
      "name": "Log Enquiry for Review",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [1120, 0],
      "parameters": {
        "resource": "record",
        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "appaDSdZkAE9PGkjT" },
        "table": { "__rl": true, "mode": "id", "value": "tblgZUj1JeGyHXmcx", "cachedResultName": "Enquiries" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Channel": "Website",
            "Enquiry Date": "={{ $now.toISO() }}",
            "Enquiry Notes": "={{ \"Category: \" + $(\"Compose Category Email\").first().json.category + \" | Free-text: \" + $(\"Compose Category Email\").first().json.note }}",
            "Raw Message": "={{ JSON.stringify($(\"Category Request Webhook\").first().json.body) }}"
          }
        },
        "options": { "typecast": true }
      }
    }
  ],
