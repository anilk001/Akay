# Copy to .env for local dev, or set these in Cloudflare Pages → Settings → Environment variables.
# The token is READ-ONLY and is used ONLY at build time to fetch offers.
# It is never shipped to the browser and never committed (see .gitignore).

# Airtable Personal Access Token — scopes: data.records:read, schema.bases:read
AIRTABLE_TOKEN=

# The "Akay Offers" base
AIRTABLE_BASE_ID=appaDSdZkAE9PGkjT
AIRTABLE_OFFERS_TABLE=Offers

# Google Analytics 4 Measurement ID (starts with "G-"). Optional.
# When set at build time, the GA4 tag is injected into every page.
# Safe to expose to the browser — that's what the PUBLIC_ prefix means in Astro.
PUBLIC_GA4_ID=

# ---- Trade assistant (the Claude chat widget on the catalogue) ----
# Server-side only. Read by netlify/functions/chat.mjs, never shipped to the
# browser. Without it the widget answers with a "not configured" message.
ANTHROPIC_API_KEY=

# n8n "Chat Quote Handler" webhook. Receives a buyer's quote request when they
# ask for it by email; logs a draft Enquiry in Airtable for review and notifies
# ak@akay.ie. Nothing is emailed to the buyer automatically.
AKAY_QUOTE_WEBHOOK_URL=https://akay-team.app.n8n.cloud/webhook/chat-quote

# WhatsApp number the assistant's prefilled quote links point at.
AKAY_WHATSAPP_NUMBER=353872382368
