# Copy to .env for local dev, or set these in Netlify → Site configuration → Environment variables.
# The token is READ-ONLY and is used ONLY at build time to fetch offers.
# It is never shipped to the browser and never committed (see .gitignore).

# Airtable Personal Access Token — scopes: data.records:read, schema.bases:read
AIRTABLE_TOKEN=

# The "Akay Offers" base
AIRTABLE_BASE_ID=appaDSdZkAE9PGkjT
AIRTABLE_OFFERS_TABLE=Offers

# Airtable Personal Access Token for the MCP server in .mcp.json (the `airtable`
# entry Claude Code starts for agent sessions). Distinct from AIRTABLE_TOKEN above
# only by name - the same PAT can be used for both. If unset, Claude Code passes
# the literal text "${AIRTABLE_API_KEY}" to the server, which then fails auth and
# reconnect-loops every session.
# CLOUD SESSIONS (claude.ai/code): set BOTH this and AIRTABLE_TOKEN in the cloud
# environment's Environment variables (the environment dialog on claude.ai), or
# the MCP server flaps and builds silently fall back to the committed snapshot.
AIRTABLE_API_KEY=

# Google Analytics 4 Measurement ID (starts with "G-"). Optional.
# When set at build time, the GA4 tag is injected into every page.
# Safe to expose to the browser — that's what the PUBLIC_ prefix means in Astro.
PUBLIC_GA4_ID=
