# Copy to .env for local dev, or set these in Netlify → Site configuration → Environment variables.
# The token is READ-ONLY and is used ONLY at build time to fetch offers.
# It is never shipped to the browser and never committed (see .gitignore).

# Airtable Personal Access Token — scopes: data.records:read, schema.bases:read
AIRTABLE_TOKEN=

# The "Akay Offers" base
AIRTABLE_BASE_ID=appaDSdZkAE9PGkjT
AIRTABLE_OFFERS_TABLE=Offers

# Google Analytics 4 Measurement ID (starts with "G-"). Optional.
# When set at build time, the GA4 tag is injected into every page.
# Safe to expose to the browser — that's what the PUBLIC_ prefix means in Astro.
PUBLIC_GA4_ID=

# n8n RFQ intake webhook (§4 of the build brief / Appendix A).
# The basket and stock-list form POST JSON here from the browser, so this value
# IS public — that is what the PUBLIC_ prefix means. Defaults to the production
# endpoint below when unset; point it at /webhook-test/akay-rfq while the n8n
# workflow is still in test mode.
#   Production: https://akay-team.app.n8n.cloud/webhook/akay-rfq
#   Test:       https://akay-team.app.n8n.cloud/webhook-test/akay-rfq
# NOTE: the webhook's CORS allow-list covers https://offers.akay.ie and the
# Netlify preview domain only, so the form cannot be exercised from a local
# dev server until that origin is added on the n8n side.
PUBLIC_RFQ_WEBHOOK_URL=
