---
// Hub page for the buyer's guides. The guide breadcrumbs and the homepage
// both point at /guides/, so this has to be a real page rather than the
// old /#guides anchor — an anchor is not a crawlable destination and the
// breadcrumb trail dead-ended on a 404 without it.
import { guides } from '../../data/guides.mjs';
import { organizationSchema, crumbs } from '../../lib/schema.mjs';
import { SITE_URL } from '../../lib/site.mjs';
import Seo from '../../components/Seo.astro';
import { WA_LINK, WA_DISPLAY } from '../../lib/whatsapp.mjs';
import SiteHeader from '../../components/SiteHeader.astro';

const orgSchema = organizationSchema();
const breadcrumbData = crumbs([
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
]);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Wholesale Trade Guides',
  url: `${SITE_URL}/guides/`,
  description:
    'Guides for wholesale beverage buyers: duty status, Incoterms, minimum orders and how to send a requirement list.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${SITE_URL}/guides/${guide.slug}/`,
      name: guide.title,
    })),
  },
};

const pageTitle = 'Wholesale Trade Guides — Duty Status, Incoterms & Ordering | AKAY Trade';
const pageDesc =
  'Practical guides for wholesale beverage and FMCG buyers: T1 vs T2 duty status, Incoterms explained, how to buy wholesale spirits in the EU, and how to format a requirement list.';
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle="AKAY Trade — Wholesale Buyer's Guides"
    path="/guides/"
    schemas={[orgSchema, listSchema, breadcrumbData]}
  />
  <style>
    :root{
      --paper:#F7F5F0; --card:#FFFFFF; --ink:#17140F; --muted:#767E72;
      --line:#E4E0D4; --brass:#B4231F;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    }
    @media (prefers-color-scheme:dark){
      :root{--paper:#0C140F; --card:#13201A; --ink:#F1EFE7; --muted:#8A968A; --line:#243029; --brass:#EC5A52}
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6}
    .container{max-width:820px;margin:0 auto;padding:24px 20px 60px}
    .breadcrumb{font-size:13px;color:var(--muted);margin-bottom:24px}
    .breadcrumb a{color:var(--brass);text-decoration:none}
    h1{font-family:var(--serif);font-size:clamp(28px,5vw,38px);line-height:1.1;margin:0 0 12px}
    .lede{color:var(--muted);margin:0 0 32px;font-size:16px}
    .guide-list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
    .guide-list a.card{display:block;background:var(--card);border:1px solid var(--line);border-radius:14px;
      padding:20px;text-decoration:none;color:inherit}
    .guide-list a.card:hover{border-color:var(--brass)}
    .guide-list h2{font-family:var(--serif);font-size:19px;margin:0 0 6px;line-height:1.25}
    .guide-list p{margin:0;color:var(--muted);font-size:14.5px}
    .nav{border-top:1px solid var(--line);margin-top:40px;padding-top:20px;font-size:14px}
    .nav a{color:var(--brass);text-decoration:none;margin-right:14px}
  </style>
</head>
<body>
  <SiteHeader section="Guides" width={820} />
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / Guides
    </nav>

    <h1>Wholesale trade guides</h1>
    <p class="lede">
      Everything a first-time trade buyer needs before sending an enquiry: what
      T1 and T2 duty status mean for your price, which Incoterm decides who pays
      freight, minimum order quantities, and how to send a requirement list so we
      can price it back to you on the spot.
    </p>

    <ul class="guide-list">
      {guides.map((guide) => (
        <li>
          <a class="card" href={`/guides/${guide.slug}/`}>
            <h2>{guide.title}</h2>
            <p>{guide.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>

    <div class="nav">
      <a href="/">← Browse live offers</a>
      <a href="/#categories">All categories</a>
      <a href="/about/">About AKAY</a>
      <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a>
    </div>
  </div>
</body>
</html>
