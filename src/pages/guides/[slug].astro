---
import SiteSearch from '../../components/SiteSearch.astro';
import { guides, getGuideBySlug, getAllGuidesSlugs } from '../../data/guides.mjs';
import { articleSchema, organizationSchema, crumbs } from '../../lib/schema.mjs';
import Seo from '../../components/Seo.astro';
import { WA_LINK, WA_DISPLAY } from '../../lib/whatsapp.mjs';

export async function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const orgSchema = organizationSchema();

// One description for the page: the <meta> tag and the Article schema below
// both take the guide's excerpt, so the two can't drift apart.
const pageTitle = `${guide.title} | AKAY Trade Guides`;
const pageDesc = guide.excerpt;
const articleData = articleSchema(guide.title, pageDesc, guide.slug);

// Guide bodies in src/data/guides.mjs are written in a small subset of
// markdown. Rendering is block-by-block on blank lines, so a bullet run
// becomes one <ul> and an indented table stays a <pre> block — the old
// line-by-line pass turned both into a column of loose <p>s, and printed
// **bold** and [links](…) as literal punctuation.
//
// Content is repo-authored, never user input, but it is still escaped before
// any tag is added so a stray < in a guide can't become markup.
// " is escaped alongside <, & and >: the link rules below drop matched text
// straight into a double-quoted href, so an unescaped quote in a URL would
// close the attribute and let the rest of the text become new attributes —
// a bare https://…"onmouseover="… in a guide would ship a live handler.
// Escaped, it decodes to a literal quote inside the value and stays inert.
const esc = (s) => s
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;');

function inline(text) {
  return esc(text)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2">$1</a>')
    // Bare URLs, the style most of the guides already use. The trailing
    // [^.,;:)] keeps sentence punctuation outside the link.
    .replace(/(^|[\s(])(https?:\/\/[^\s<)]*[^\s<).,;:])/g, '$1<a href="$2">$2</a>');
}

function renderGuide(content) {
  // Guides often put a heading directly above its first line with no blank
  // line between; force the break so the heading doesn't swallow that line.
  return content.replace(/^(#{2,3} .*)$/gm, '$1\n').split(/\n{2,}/).map((block) => {
    const b = block.trim();
    if (!b) return '';
    if (b.startsWith('## ')) return `<h2>${inline(b.slice(3))}</h2>`;
    if (b.startsWith('### ')) return `<h3>${inline(b.slice(4))}</h3>`;
    // Fenced or 4-space-indented block: keep it verbatim, it's a table or sample.
    if (b.startsWith('```')) {
      return `<pre><code>${esc(b.replace(/^```[^\n]*\n?/, '').replace(/\n?```$/, ''))}</code></pre>`;
    }
    if (block.split('\n').every((l) => !l.trim() || /^ {4}/.test(l))) {
      return `<pre><code>${esc(block.replace(/^ {4}/gm, '').trim())}</code></pre>`;
    }
    // Guides often run a bullet list straight on from its lead-in line with no
    // blank line between, so group consecutive lines by kind rather than
    // typing the whole block from its first character. Plain lines inside one
    // block are soft breaks (address blocks, "Example:" lines).
    const out = [];
    let buf = [];
    let mode = null;
    const flush = () => {
      if (!buf.length) return;
      if (mode === 'ul') {
        out.push(`<ul>${buf.map((l) => `<li>${inline(l.replace(/^[-*]\s+/, ''))}</li>`).join('')}</ul>`);
      } else if (mode === 'ol') {
        out.push(`<ol>${buf.map((l) => `<li>${inline(l.replace(/^\d+\.\s+/, ''))}</li>`).join('')}</ol>`);
      } else {
        out.push(`<p>${buf.map(inline).join('<br />')}</p>`);
      }
      buf = [];
    };
    for (const line of b.split('\n').map((l) => l.trim()).filter(Boolean)) {
      const kind = /^[-*]\s/.test(line) ? 'ul' : /^\d+\.\s/.test(line) ? 'ol' : 'p';
      if (kind !== mode) { flush(); mode = kind; }
      buf.push(line);
    }
    flush();
    return out.join('');
  }).join('');
}

const guideHtml = renderGuide(guide.content);

const breadcrumbData = crumbs([
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: guide.title, path: `/guides/${guide.slug}/` },
]);
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle={guide.title}
    path={`/guides/${guide.slug}/`}
    type="article"
    schemas={[orgSchema, articleData, breadcrumbData]}
  />

  <style>
    :root {
      --paper: #F7F5F0;
      --paper-2: #EFEDE4;
      --card: #FFFFFF;
      --ink: #17140F;
      --ink-soft: #41473F;
      --muted: #767E72;
      --line: #E4E0D4;
      --brass: #B4231F;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --mono: ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F;
        --paper-2: #081009;
        --card: #13201A;
        --ink: #F1EFE7;
        --ink-soft: #C6CEC4;
        --muted: #8A968A;
        --line: #243029;
        --brass: #EC5A52;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.6 var(--sans);
    }

    h1 {
      font: 600 2.2em var(--serif);
      margin: 1em 0 0.3em;
      color: var(--ink);
    }

    h2 {
      font: 600 1.5em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }

    h3 {
      font: 600 1.2em var(--serif);
      margin: 1.2em 0 0.4em;
      color: var(--ink-soft);
    }

    a {
      color: var(--brass);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    p {
      margin: 1em 0;
    }

    code {
      background: var(--paper-2);
      padding: 0.2em 0.4em;
      border-radius: 4px;
      font: 0.9em var(--mono);
      color: var(--ink);
    }

    pre {
      background: var(--paper-2);
      padding: 1em;
      border-radius: 8px;
      overflow-x: auto;
      font: 0.9em / 1.5 var(--mono);
      border-left: 3px solid var(--brass);
    }

    pre code {
      background: none;
      padding: 0;
      color: inherit;
    }

    strong {
      font-weight: 700;
    }

    em {
      font-style: italic;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5em 0;
    }

    th,
    td {
      padding: 0.75em;
      text-align: left;
      border-bottom: 1px solid var(--line);
    }

    th {
      background: var(--paper-2);
      font-weight: 600;
      color: var(--ink-soft);
    }

    ul,
    ol {
      margin: 1em 0;
      padding-left: 2em;
    }

    li {
      margin: 0.5em 0;
    }

    .container {
      max-width: 780px;
      margin: 0 auto;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 1.5em;
    }

    .breadcrumb a {
      color: var(--brass);
    }

    .article-meta {
      color: var(--muted);
      font-size: 0.95em;
      margin-bottom: 2em;
      padding-bottom: 1.5em;
      border-bottom: 1px solid var(--line);
    }

    .article-content {
      line-height: 1.8;
    }

    .article-content > *:first-child {
      margin-top: 0;
    }

    /* The body is injected with set:html, so its tags carry no scope
       attribute and none of the element rules above ever reached them —
       guide prose has been rendering at browser defaults. Re-declare them
       through :global() for the injected tree. Values mirror the scoped
       rules so the body matches the rest of the page. */
    .article-content :global(h2) {
      font: 600 1.5em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }

    .article-content :global(h3) {
      font: 600 1.2em var(--serif);
      margin: 1.2em 0 0.4em;
      color: var(--ink-soft);
    }

    .article-content :global(p) {
      margin: 1em 0;
    }

    .article-content :global(a) {
      color: var(--brass);
      text-decoration: none;
      border-bottom: 1px solid color-mix(in srgb, var(--brass) 40%, transparent);
      /* Bare URLs in the guides are long enough to overflow a phone. */
      overflow-wrap: anywhere;
    }

    .article-content :global(a:hover) {
      color: var(--forest);
    }

    .article-content :global(strong) {
      font-weight: 700;
      color: var(--ink);
    }

    .article-content :global(em) {
      font-style: italic;
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin: 1em 0;
      padding-left: 1.6em;
    }

    .article-content :global(li) {
      margin: 0.4em 0;
    }

    .article-content :global(pre) {
      background: var(--paper-2);
      padding: 1em;
      border-radius: 8px;
      overflow-x: auto;
      font: 0.9em / 1.5 var(--mono);
      border-left: 3px solid var(--brass);
    }

    .article-content :global(code) {
      background: var(--paper-2);
      padding: 0.2em 0.4em;
      border-radius: 4px;
      font: 0.9em var(--mono);
      color: var(--ink);
    }

    .article-content :global(pre code) {
      background: none;
      padding: 0;
      color: inherit;
    }

    .footer {
      margin-top: 3em;
      padding-top: 2em;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.9em;
    }

    .footer a {
      color: var(--brass);
    }

    .related-guides {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      margin: 3em 0;
      box-shadow: var(--shadow);
    }

    .related-guides h3 {
      margin-top: 0;
    }

    .related-guides ul {
      list-style: none;
      padding: 0;
    }

    .related-guides li {
      margin: 0.8em 0;
    }

    .related-guides a {
      font-weight: 500;
    }

    .cta {
      background: var(--card);
      border: 2px solid var(--brass);
      border-radius: var(--radius);
      padding: 2em;
      margin: 2em 0;
      text-align: center;
    }

    .cta h3 {
      margin-top: 0;
      color: var(--brass);
    }

    .cta-button {
      display: inline-block;
      background: var(--brass);
      color: white;
      padding: 0.8em 1.6em;
      border-radius: 6px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      margin: 0.5em;
    }

    .cta-button:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body>
  <div class="container">
    <SiteSearch />
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/guides/">Guides</a> / {guide.title}
    </div>

    <article>
      <h1>{guide.title}</h1>

      <div class="article-meta">
        From the AKAY Trade guides library. Last updated 2024.
      </div>

      <div class="article-content" set:html={guideHtml} />

    </article>

    <div class="cta">
      <h3>Ready to order?</h3>
      <p>Browse our live catalogue and get a quote for wholesale pricing.</p>
      <a href="/" class="cta-button">Browse Offers</a>
      <a href={WA_LINK} class="cta-button" target="_blank" rel="noopener">WhatsApp Enquiry</a>
    </div>

    <div class="related-guides">
      <h3>More Guides</h3>
      <ul>
        {guides
          .filter((g) => g.slug !== guide.slug)
          .map((g) => (
            <li>
              <a href={`/guides/${g.slug}/`}>{g.title}</a>
              <p style="margin: 0.3em 0 0; font-size: 0.9em; color: var(--muted);">{g.excerpt}</p>
            </li>
          ))}
      </ul>
    </div>

    <div class="footer">
      <p>
        <strong>Questions?</strong> Contact us at <a href="mailto:offers@akay.ie">offers@akay.ie</a> or{' '}
        <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a>.
      </p>
      <p>
        <a href="/">← Back to catalogue</a> | <a href="/about/">About AKAY</a>
      </p>
    </div>
  </div>
</body>
</html>
