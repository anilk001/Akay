  <script is:inline>
    // The mock autoplays, so there has to be a way to stop it (WCAG 2.2.2).
    // The button ships hidden and is only revealed here: without JS it could
    // not do anything, and the animation stops on its own after three passes.
    (function () {
      var demo = document.getElementById('demo');
      var btn = document.getElementById('playerToggle');
      if (!demo || !btn) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var label = document.getElementById('playerToggleLabel');
      var PAUSE = '<path d="M8 5h3v14H8zM13 5h3v14h-3z"/>';
      var PLAY = '<path d="M7 4.5v15a1 1 0 0 0 1.54.84l11.2-7.5a1 1 0 0 0 0-1.68L8.54 3.66A1 1 0 0 0 7 4.5Z"/>';
      var icon = btn.querySelector('svg');
      var finished = false;

      function render() {
        var paused = demo.classList.contains('d-paused');
        var text = finished ? 'Replay' : paused ? 'Play' : 'Pause';
        label.textContent = text;
        icon.innerHTML = finished || paused ? PLAY : PAUSE;
        btn.setAttribute('aria-label', text + ' the Instant Quote demo');
      }

      // The scrubber runs the whole cycle, so its last animationend is the
      // moment the demo has settled on the finished file.
      var scrub = demo.querySelector('.d-scrub i');
      if (scrub) scrub.addEventListener('animationend', function () { finished = true; render(); });

      btn.addEventListener('click', function () {
        if (finished) {
          demo.classList.remove('d-run', 'd-paused');
          void demo.offsetWidth; // restart the animations from zero
          demo.classList.add('d-run');
          finished = false;
        } else {
          demo.classList.toggle('d-paused');
        }
        render();
      });

      btn.hidden = false;
      render();
    })();
  </script>
