---
// §1 — the category directory. Nine categories, linked from the header.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCatalogue } from '../lib/catalogue.mjs';
import { aggregationFacts } from '../lib/aggregation-intro.mjs';
import { organizationSchema, breadcrumbList } from '../lib/schema.mjs';
import { brandSlug } from '../lib/slug.mjs';

const { categories, stats } = await getCatalogue();

const rows = categories.map((c) => {
  const f = aggregationFacts(c.offers);
  // Three deepest brands per category — enough to show what the category
  // actually contains without turning the page into a second brand directory.
  const counts = new Map();
  for (const o of c.offers) if (o.brand) counts.set(o.brand, (counts.get(o.brand) || 0) + 1);
  const top = [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 3)
    .map(([name]) => ({ name, slug: brandSlug(name) }));
  return { ...c, facts: f, top };
});

const title = 'Wholesale categories — Export Case Prices | Akay Irl Ltd';
const description = `All ${stats.categories} categories on the AKAY trade catalogue: ${stats.offers} live lines across ${stats.brands} brands, with case pricing, customs status and loading terms.`;

const jsonLd = [
  organizationSchema(),
  breadcrumbList([{ name: 'Home', path: '/' }, { name: 'Categories', path: '/categories/' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Wholesale categories',
    url: 'https://offers.akay.ie/categories/',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: categories.length,
      itemListElement: categories.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        url: `https://offers.akay.ie/category/${c.slug}/`,
      })),
    },
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} i18nPath="/categories/" wide={true}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Catalogue</a><span aria-hidden="true">/</span><span aria-current="page">Categories</span>
  </nav>

  <header class="dir-head">
    <p class="eyebrow">Directory</p>
    <h1>All categories</h1>
    <p class="dir-intro">
      {stats.offers} live lines across {stats.categories} categories and {stats.brands} brands.
      Each category page carries the current case price, pack spec, customs status and loading
      point for every line in it.
    </p>
  </header>

  <div class="cat-grid">
    {rows.map((c) => (
      <article class="cat-card">
        <h2><a href={`/category/${c.slug}/`}>{c.name}</a></h2>
        <dl class="cat-stats">
          <div><dt>Lines</dt><dd>{c.facts.lines}</dd></div>
          <div><dt>Brands</dt><dd>{c.facts.brands.length}</dd></div>
          {c.facts.inStock > 0 && <div><dt>In stock</dt><dd>{c.facts.inStock}</dd></div>}
        </dl>
        {c.facts.tiers.length > 0 && (
          <p class="cat-meta"><span>Customs status</span> {c.facts.tiers.join(' · ')}</p>
        )}
        {c.facts.currencies.length > 0 && (
          <p class="cat-meta"><span>Priced in</span> {c.facts.currencies.join(' / ')}</p>
        )}
        {c.top.length > 0 && (
          <p class="cat-brands">
            <span>Deepest brands</span>
            {c.top.map((b, i) => (
              <>{i > 0 && ' · '}<a href={`/brand/${b.slug}/`}>{b.name}</a></>
            ))}
          </p>
        )}
        <a class="cat-go" href={`/category/${c.slug}/`}>Browse {c.facts.lines} {c.name.toLowerCase()} lines →</a>
      </article>
    ))}
  </div>

  <nav class="agg-links" aria-label="Related">
    <span class="agg-links-label">More:</span>
    <a href="/brands/">All brands</a>
    <a href="/trade-terms/">Trade terms and Incoterms</a>
    <a href="/customs-glossary/">T1, T2 and bonded explained</a>
  </nav>
</BaseLayout>

<style>
  .crumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:12.5px;color:var(--muted);margin-bottom:18px;font-family:var(--mono)}
  .crumbs a{color:var(--brass);text-decoration:none}
  .dir-head{margin-bottom:26px;padding-bottom:20px;border-bottom:1px solid var(--line)}
  .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);margin:0 0 10px}
  h1{font-family:var(--serif);font-weight:600;font-size:clamp(28px,4vw,38px);line-height:1.06;margin:0 0 14px}
  .dir-intro{margin:0;color:var(--ink-soft);font-size:15px;max-width:74ch}

  .cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .cat-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);display:flex;flex-direction:column}
  .cat-card h2{font-family:var(--serif);font-size:20px;font-weight:600;margin:0 0 12px}
  .cat-card h2 a{color:var(--ink);text-decoration:none}
  .cat-card h2 a:hover{color:var(--brass)}
  .cat-stats{display:flex;gap:20px;margin:0 0 14px;padding-bottom:13px;border-bottom:1px solid var(--line-soft)}
  .cat-stats dt{font-size:11px;color:var(--muted);letter-spacing:.03em}
  .cat-stats dd{margin:2px 0 0;font-family:var(--mono);font-size:18px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
  .cat-meta,.cat-brands{margin:0 0 7px;font-size:12.5px;color:var(--ink-soft);line-height:1.5}
  .cat-meta span,.cat-brands span{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.07em;
    text-transform:uppercase;color:var(--muted);margin-bottom:1px}
  .cat-brands a{color:var(--brass);text-decoration:none}
  .cat-brands a:hover{text-decoration:underline}
  .cat-go{margin-top:auto;padding-top:15px;font-size:13.5px;font-weight:600;color:var(--brass);text-decoration:none}
  .cat-go:hover{text-decoration:underline}

  .agg-links{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);
    display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;font-size:13.5px}
  .agg-links-label{color:var(--muted);font-size:12.5px}
  .agg-links a{color:var(--brass);text-decoration:none}
  .agg-links a:hover{text-decoration:underline}
</style>
