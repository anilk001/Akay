---
import { getOffers } from '../../data/airtable.mjs';
import { brandPages, categorySlug } from '../../lib/slug.mjs';
import { organizationSchema } from '../../lib/schema.mjs';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Seo from '../../components/Seo.astro';

const { offers } = await getOffers();
// The directory only lists brands, so raw offers (no slugs) are enough here.
const pages = brandPages(offers);
const categories = Array.from(new Set(offers.map((o) => o.category))).sort();

// Group alphabetically for scannability.
const groups = new Map();
for (const p of pages) {
  const letter = /^[a-z]/i.test(p.brand) ? p.brand[0].toUpperCase() : '#';
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter).push(p);
}

const orgSchema = organizationSchema();
const pageTitle = `Wholesale Brands A–Z — ${pages.length} Brands in Stock | AKAY Trade`;
const pageDesc = `Browse ${pages.length} wholesale brands stocked by AKAY Trade — spirits, beer, soft drinks, confectionery and FMCG by the case. Live trade pricing and duty status on every offer.`;
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle="Wholesale Brands A–Z"
    path="/brands/"
    schemas={[orgSchema]}
  />

  <style>

    body {
      margin: 0;
      padding: 0;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    h2 {
      font: 600 1.2em var(--serif);
      margin: 1.5em 0 0.5em;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.3em;
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 24px 20px 48px;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }

    .intro {
      color: var(--muted);
      max-width: 70ch;
    }

    /* Flex, not inline text: the links are rendered with no whitespace
       between them, so as inline nowrap runs they made one unbreakable line
       and pushed phones into a sideways scroll. */
    .cat-links {
      margin: 1em 0 2em;
      font-size: 0.95em;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3em 0.9em;
    }
    .cat-links a {
      white-space: nowrap;
    }

    .brand-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em 1.4em;
      list-style: none;
      margin: 0.8em 0 0;
      padding: 0;
    }
    .brand-list a {
      white-space: nowrap;
    }
    .brand-list .n {
      color: var(--muted);
      font-size: 0.85em;
    }

    .nav {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      margin-top: 3em;
    }
  </style>
</head>
<body>
  <SiteHeader current="brands" />
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / Brands
    </div>

    <h1>Wholesale Brands A–Z</h1>
    <p class="intro">
      {pages.length} brands currently in the AKAY trade catalogue — spirits, beer, soft drinks,
      confectionery and FMCG by the case. Every brand page lists live offers with pricing,
      pack specs and duty status.
    </p>

    <p class="cat-links">
      Browse by category:
      {categories.map((c) => <a href={`/category/${categorySlug(c)}/`}>{c}</a>)}
    </p>

    {[...groups.keys()].map((letter) => (
      <section>
        <h2>{letter}</h2>
        <ul class="brand-list">
          {groups.get(letter).map((p) => (
            <li><a href={`/brands/${p.slug}/`}>{p.brand}</a> <span class="n">({p.offers.length})</span></li>
          ))}
        </ul>
      </section>
    ))}

    <div class="nav">
      <a href="/">← Full catalogue</a>
    </div>
  </div>
  <SiteFooter />
</body>
</html>
