---
import { getOffers } from '../../data/airtable.mjs';
import { offersWithSlugs, brandPages, categorySlug } from '../../lib/slug.mjs';
import { brandCollectionSchema, organizationSchema } from '../../lib/schema.mjs';
import { basisLabel } from '../../lib/price.mjs';

export async function getStaticPaths() {
  const { offers } = await getOffers();
  const all = offersWithSlugs(offers);
  return brandPages(all).map(({ brand, slug, offers: brandOffers }) => ({
    params: { brand: slug },
    props: { brand, brandUrlSlug: slug, brandOffers },
  }));
}

const { brand, brandUrlSlug, brandOffers } = Astro.props;

// Featured first, then keep catalogue order.
const sorted = [...brandOffers].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

const categories = Array.from(new Set(sorted.map((o) => o.category))).sort();
const priced = sorted.filter((o) => o.amount != null);
const lowPrice = priced.length ? Math.min(...priced.map((o) => o.amount)) : null;
const currency = priced[0]?.currency || '';

const orgSchema = organizationSchema();
const collectionSchema = brandCollectionSchema(brand, brandUrlSlug, sorted);

const pageTitle = `${brand} Wholesale — Trade Offers & Case Pricing | AKAY Trade`;
const pageDesc = `Buy ${brand} wholesale from AKAY Trade: ${sorted.length} live offers${
  lowPrice != null ? ` from ${currency} ${lowPrice.toFixed(2)}` : ''
}. Case pricing, pack specs and duty status on every line. Duty-paid & export.`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="icon" href="/akay-bird.png" />
  <link rel="canonical" href={`https://offers.akay.ie/brands/${brandUrlSlug}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AKAY Trade" />
  <meta property="og:url" content={`https://offers.akay.ie/brands/${brandUrlSlug}/`} />
  <meta property="og:title" content={`${brand} Wholesale Offers`} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="https://offers.akay.ie/akay-bird.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${brand} Wholesale Offers`} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="robots" content="max-snippet:-1, max-image-preview:large" />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <style>
    :root {
      --paper: #F7F5F0;
      --paper-2: #EFEDE4;
      --card: #FFFFFF;
      --ink: #17140F;
      --ink-soft: #41473F;
      --muted: #767E72;
      --line: #E4E0D4;
      --brass: #B4231F;
      --ok: #0E7A3B;
      --ok-bg: #E2F0E5;
      --warn: #9A6A12;
      --warn-bg: #F5E9CE;
      --neu: #5C6A78;
      --neu-bg: #E9ECEF;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F;
        --paper-2: #081009;
        --card: #13201A;
        --ink: #F1EFE7;
        --ink-soft: #C6CEC4;
        --muted: #8A968A;
        --line: #243029;
        --brass: #EC5A52;
        --ok: #5FC97E;
        --ok-bg: #123021;
        --warn: #E0B65C;
        --warn-bg: #31280F;
        --neu: #9AA7B4;
        --neu-bg: #1B2530;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    body {
      margin: 0;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }

    .header p {
      color: var(--muted);
      font-size: 1em;
      margin: 0.5em 0 0;
      max-width: 70ch;
    }

    .cat-links {
      margin: 1em 0 0;
      font-size: 0.9em;
      color: var(--muted);
    }
    .cat-links a {
      margin-right: 0.8em;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5em;
      margin: 2em 0;
    }

    .offer-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .offer-card h2 {
      margin: 0 0 0.5em;
      font: 600 1.1em var(--serif);
      color: var(--ink);
    }

    .offer-card p {
      margin: 0.3em 0;
      color: var(--muted);
      font-size: 0.9em;
    }

    .offer-card .price {
      font: 600 1.3em var(--serif);
      color: var(--brass);
      margin: 0.8em 0 0.5em;
    }

    .offer-card .stock {
      font-size: 0.85em;
      font-weight: 600;
      padding: 0.3em 0.6em;
      border-radius: 4px;
      display: inline-block;
      margin: 0.5em 0;
    }

    .stock-ok { background: var(--ok-bg); color: var(--ok); }
    .stock-warn { background: var(--warn-bg); color: var(--warn); }
    .stock-neu { background: var(--neu-bg); color: var(--neu); }

    .offer-card a.view-link {
      font-weight: 600;
      margin-top: auto;
      padding-top: 1em;
      border-top: 1px solid var(--line);
    }

    .nav {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      margin-top: 3em;
    }

    .nav a {
      margin: 0 1em;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/brands/">Brands</a> / {brand}
    </div>

    <div class="header">
      <h1>{brand} Wholesale Offers</h1>
      <p>
        {sorted.length} live {brand} trade {sorted.length === 1 ? 'offer' : 'offers'} from AKAY —
        wholesale by the case with current pricing, pack specs and duty tier on every line.
        Duty-paid (T2) and export / under-bond (T1) supply.
      </p>
      {categories.length > 0 && (
        <p class="cat-links">
          In: {categories.map((c) => <a href={`/category/${categorySlug(c)}/`}>{c}</a>)}
        </p>
      )}
    </div>

    <div class="offer-grid">
      {sorted.map((offer) => {
        const stockStatus = offer.stock === 'in' ? 'ok' : offer.stock === 'warn' ? 'warn' : 'neu';
        const stockText = offer.stock === 'in' ? 'In stock' : offer.stock === 'warn' ? 'Limited' : 'Enquire';
        return (
          <div class="offer-card">
            <h2><a href={`/offers/${offer.slug}/`}>{offer.name}</a></h2>
            {offer.spec && <p>{offer.spec}</p>}
            <div class="price">{offer.currency}{offer.amount?.toFixed(2) || '—'} {basisLabel(offer.priceBasis)}</div>
            <span class={`stock stock-${stockStatus}`}>{stockText}</span>
            {offer.tier && <p><strong>Duty:</strong> {offer.tier}</p>}
            <a href={`/offers/${offer.slug}/`} class="view-link">View offer →</a>
          </div>
        );
      })}
    </div>

    <div class="nav">
      <a href="/brands/">← All brands</a>
      |
      <a href="/">Full catalogue</a>
    </div>
  </div>
</body>
</html>
