---
import { getOffers } from '../../data/airtable.mjs';
import { withSlugs, brandPages, categorySlug } from '../../lib/slug.mjs';
import { brandCollectionSchema, organizationSchema } from '../../lib/schema.mjs';
import { priceLabel } from '../../lib/price.mjs';
import { listingTermsLine } from '../../lib/trade-terms.mjs';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { brandAnswers, faqSchema } from '../../lib/buying-answers.mjs';
import { absoluteUrl } from '../../lib/site.mjs';
import Seo from '../../components/Seo.astro';

export async function getStaticPaths() {
  // Live stock only — sold-out archive pages link back here, never the
  // other way round. Slugs come through the same combined derivation as
  // offers/[slug].astro so brand-card links always hit built pages.
  const { offers, delisted } = await getOffers();
  const all = withSlugs([...offers, ...delisted]).filter((o) => !o.delisted);
  return brandPages(all).map(({ brand, slug, offers: brandOffers }) => ({
    params: { brand: slug },
    props: { brand, brandUrlSlug: slug, brandOffers },
  }));
}

const { brand, brandUrlSlug, brandOffers } = Astro.props;

// Featured first, then keep catalogue order.
const sorted = [...brandOffers].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

const categories = Array.from(new Set(sorted.map((o) => o.category))).sort();
const priced = sorted.filter((o) => o.amount != null);
const lowPrice = priced.length ? Math.min(...priced.map((o) => o.amount)) : null;
const currency = priced[0]?.currency || '';

const orgSchema = organizationSchema();
const collectionSchema = brandCollectionSchema(brand, brandUrlSlug, sorted);
const answers = brandAnswers(brand, sorted);
const brandFaqSchema = faqSchema(answers.faq, absoluteUrl(`/brands/${brandUrlSlug}/`));

const pageTitle = `${brand} Wholesale — Trade Offers & Case Pricing | AKAY Trade`;
const pageDesc = `Buy ${brand} wholesale from AKAY Trade: ${sorted.length} live offers${
  lowPrice != null ? ` from ${currency} ${lowPrice.toFixed(2)}` : ''
}. Case pricing, pack specs and duty status on every line. Duty-paid & export.`;
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle={`${brand} Wholesale Offers`}
    path={`/brands/${brandUrlSlug}/`}
    schemas={[orgSchema, collectionSchema, brandFaqSchema]}
  />

  <style>

    body {
      margin: 0;
      padding: 0;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 24px 20px 48px;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }

    .header p {
      color: var(--muted);
      font-size: 1em;
      margin: 0.5em 0 0;
      max-width: 70ch;
    }

    .cat-links {
      margin: 1em 0 0;
      font-size: 0.9em;
      color: var(--muted);
    }
    .cat-links a {
      margin-right: 0.8em;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5em;
      margin: 2em 0;
    }

    .offer-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .offer-card h2 {
      margin: 0 0 0.5em;
      font: 600 1.1em var(--serif);
      color: var(--ink);
    }

    .offer-card p {
      margin: 0.3em 0;
      color: var(--muted);
      font-size: 0.9em;
    }

    /* MOQ and lead time on a scanning card: present but subordinate to the
       price and stock, which are what a buyer sorts on. */
    .offer-card p.terms-line {
      font-size: 0.85em;
      color: var(--muted);
    }

    .offer-card .price {
      font: 600 1.3em var(--serif);
      color: var(--brass);
      margin: 0.8em 0 0.5em;
    }

    .offer-card .stock {
      font-size: 0.85em;
      font-weight: 600;
      padding: 0.3em 0.6em;
      border-radius: 4px;
      display: inline-block;
      margin: 0.5em 0;
    }

    .stock-ok { background: var(--ok-bg); color: var(--ok); }
    .stock-warn { background: var(--warn-bg); color: var(--warn); }
    .stock-neu { background: var(--neu-bg); color: var(--neu); }

    .offer-card a.view-link {
      font-weight: 600;
      margin-top: auto;
      padding-top: 1em;
      border-top: 1px solid var(--line);
    }

    .buying,
    .faq {
      max-width: 70ch;
      margin: 2em 0 0;
    }
    .buying h2,
    .faq h2 {
      font: 600 1.35em var(--serif);
      margin: 0 0 0.5em;
    }
    .buying p {
      margin: 0 0 0.6em;
      color: var(--ink-soft);
    }
    .faq-item {
      border-top: 1px solid var(--line);
      padding: 0.9em 0;
    }
    .faq-item h3 {
      font: 600 1em var(--sans);
      margin: 0 0 0.3em;
    }
    .faq-item p {
      margin: 0;
      color: var(--ink-soft);
    }

    .nav {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      margin-top: 3em;
    }

    .nav a {
      margin: 0 1em;
    }
  </style>
</head>
<body>
  <SiteHeader current="brands" />
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/brands/">Brands</a> / {brand}
    </div>

    <div class="header">
      <h1>{brand} Wholesale Offers</h1>
      <p>
        {sorted.length} live {brand} trade {sorted.length === 1 ? 'offer' : 'offers'} from AKAY —
        wholesale by the case with current pricing, pack specs and duty tier on every line.
        Duty-paid (T2) and export / under-bond (T1) supply.
      </p>
      {categories.length > 0 && (
        <p class="cat-links">
          In: {categories.map((c) => <a href={`/category/${categorySlug(c)}/`}>{c}</a>)}
        </p>
      )}
    </div>

    <section class="buying" aria-labelledby="buying-heading">
      <h2 id="buying-heading">Buying {brand} wholesale from AKAY</h2>
      {answers.summary.map((line) => <p>{line}</p>)}
    </section>

    <div class="offer-grid">
      {sorted.map((offer) => {
        const stockStatus = offer.stock === 'in' ? 'ok' : offer.stock === 'warn' ? 'warn' : 'neu';
        const stockText = offer.stock === 'in' ? 'In stock' : offer.stock === 'warn' ? 'Limited' : 'Enquire';
        return (
          <div class="offer-card">
            <h2><a href={`/offers/${offer.canonicalSlug || offer.slug}/`}>{offer.name}</a></h2>
            {offer.spec && <p>{offer.spec}</p>}
            <div class="price">{priceLabel(offer, { short: true })}</div>
            <span class={`stock stock-${stockStatus}`}>{stockText}</span>
            {offer.tier && <p><strong>Duty:</strong> {offer.tier}</p>}
            {listingTermsLine(offer) && <p class="terms-line">{listingTermsLine(offer)}</p>}
            <a href={`/offers/${offer.canonicalSlug || offer.slug}/`} class="view-link">View offer →</a>
          </div>
        );
      })}
    </div>

    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{brand}: common questions</h2>
      {answers.faq.map(({ q, a }) => (
        <div class="faq-item">
          <h3>{q}</h3>
          <p>{a}</p>
        </div>
      ))}
    </section>

    <div class="nav">
      <a href="/brands/">← All brands</a>
      |
      <a href="/">Full catalogue</a>
    </div>
  </div>
  <SiteFooter />
</body>
</html>
