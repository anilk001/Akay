---
// Netlify serves this for any unmatched path. Offer slugs change whenever a
// product name changes in Airtable, so old links from search results and
// WhatsApp threads land here regularly — it needs to route people back into
// the catalogue rather than dead-ending, and it must be noindex.
import { getOffers } from '../data/airtable.mjs';
import { categorySlug } from '../lib/slug.mjs';
import { guides } from '../data/guides.mjs';
import Seo from '../components/Seo.astro';
import { WA_LINK, WA_DISPLAY } from '../lib/whatsapp.mjs';
import SiteHeader from '../components/SiteHeader.astro';

const { offers } = await getOffers();
const categories = Array.from(new Set(offers.map((o) => o.category).filter(Boolean))).sort();
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title="Page not found — AKAY Trade"
    description="That page has moved or the offer is no longer live. Browse the current AKAY Trade wholesale catalogue."
    path="/404"
    noindex={true}
  />
  <style>
    :root{
      --paper:#F7F5F0; --card:#FFFFFF; --ink:#17140F; --muted:#767E72;
      --line:#E4E0D4; --brass:#B4231F;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    }
    @media (prefers-color-scheme:dark){
      :root{--paper:#0C140F; --card:#13201A; --ink:#F1EFE7; --muted:#8A968A; --line:#243029; --brass:#EC5A52}
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6}
    .container{max-width:720px;margin:0 auto;padding:44px 20px 60px}
    h1{font-family:var(--serif);font-size:clamp(28px,5vw,40px);margin:0 0 12px;line-height:1.1}
    .lede{color:var(--muted);margin:0 0 28px}
    h2{font-size:15px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:32px 0 12px}
    ul{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0}
    ul a{display:inline-block;background:var(--card);border:1px solid var(--line);border-radius:999px;
      padding:8px 14px;color:var(--ink);text-decoration:none;font-size:14px}
    ul a:hover{border-color:var(--brass);color:var(--brass)}
    .cta{display:inline-block;margin-top:28px;background:var(--brass);color:#fff;border-radius:10px;
      padding:11px 18px;text-decoration:none;font-weight:600}
  </style>
</head>
<body>
  <SiteHeader width={720} />
  <div class="container">
    <h1>That page isn't here</h1>
    <p class="lede">
      The offer may have sold out, or its listing changed name — our catalogue
      updates continuously. Everything currently live is one click away.
    </p>

    <h2>Browse by category</h2>
    <ul>
      {categories.map((c) => (
        <li><a href={`/category/${categorySlug(c)}/`}>{c}</a></li>
      ))}
    </ul>

    <h2>Buyer's guides</h2>
    <ul>
      {guides.map((g) => (
        <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
      ))}
    </ul>

    <a class="cta" href="/">Browse all live offers →</a>

    <p style="margin-top:28px;color:var(--muted);font-size:14px">
      Looking for something specific? WhatsApp
      <a href={WA_LINK} target="_blank" rel="noopener" style="color:var(--brass)">{WA_DISPLAY}</a>
      or email <a href="mailto:offers@akay.ie" style="color:var(--brass)">offers@akay.ie</a> —
      see <a href="/guides/requirement-list-format/" style="color:var(--brass)">how to send a requirement list</a>.
    </p>
  </div>
</body>
</html>
