---
// Custom 404.
//
// The catalogue turns over hard: across the committed history of
// offers-snapshot.json, 4,690 offer URLs have been published and only ~2,540
// are live at any moment. A 404 is the correct status for an offer that has
// genuinely sold out or expired — Google wants removed products to 404 rather
// than linger as thin "no longer available" pages — but the DEFAULT 404 is a
// dead end, and every one of those ~2,100 dead URLs is a buyer who arrived
// from a bookmark, an old quote, or a stale search result.
//
// So the page stays a real 404 and instead does two things: it names the
// product that used to live at this URL (looked up client-side from
// /retired-offers.json, fetched only here so no normal page pays for it), and
// it always offers the live catalogue by category. Marked noindex so the 404
// itself never competes for a query.
import { guides } from '../data/guides.mjs';

const CATEGORIES = [
  'Spirits', 'Beer', 'Wine', 'Champagne',
  'Soft Drinks', 'Grocery', 'Confectionery', 'Toiletries', 'Other FMCG',
];
const catSlug = (c) => c.toLowerCase().replace(/\s+/g, '-');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Offer not found — AKAY Trade</title>
  <meta name="description" content="This AKAY offer is no longer live. Browse the current wholesale catalogue by category — spirits, beer, soft drinks, grocery and FMCG by the case and pallet." />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/akay-bird.png" />
  <style>
    :root{
      --paper:#F7F5F0; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --brass:#B4231F; --brass-2:#D0362E;
      --shadow:0 1px 2px rgba(20,33,26,.06),0 6px 20px -8px rgba(20,33,26,.14);
      --radius:14px;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      --mono:ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --paper:#0C140F; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
        --muted:#8A968A; --line:#243029; --brass:#EC5A52; --brass-2:#F26E66;
        --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
      }
    }
    :root[data-theme="dark"]{
      --paper:#0C140F; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
      --muted:#8A968A; --line:#243029; --brass:#EC5A52; --brass-2:#F26E66;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.55;-webkit-font-smoothing:antialiased}
    .wrap{max-width:760px;margin:0 auto;padding:48px 20px 72px}
    .mark{display:inline-flex;align-items:center;gap:9px;font-family:var(--serif);font-weight:600;font-size:26px;color:var(--ink);text-decoration:none}
    .mark b{color:var(--brass)}
    .code{font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--muted);margin:40px 0 8px;text-transform:uppercase}
    h1{font-family:var(--serif);font-size:clamp(28px,5vw,40px);line-height:1.15;margin:0 0 14px}
    p{color:var(--ink-soft);margin:0 0 16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px 22px;margin:26px 0}
    .card h2{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 10px;font-weight:600}
    .prod{font-family:var(--serif);font-size:20px;color:var(--ink);margin:0 0 6px}
    .cats{display:flex;flex-wrap:wrap;gap:9px;margin:18px 0 0;padding:0;list-style:none}
    .cats a{display:inline-block;font-family:var(--mono);font-size:13px;text-decoration:none;color:var(--ink-soft);
      border:1px solid var(--line);background:var(--card);border-radius:9px;padding:8px 13px}
    .cats a:hover{border-color:var(--brass);color:var(--brass)}
    .cta{display:inline-block;background:var(--brass);color:#fff;text-decoration:none;font-weight:600;
      border-radius:10px;padding:12px 20px;margin:6px 10px 0 0}
    .cta.alt{background:transparent;color:var(--brass);border:1px solid var(--brass)}
    .foot{margin-top:44px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--muted)}
    .foot a{color:var(--brass);text-decoration:none}
    [hidden]{display:none !important}
  </style>
</head>
<body>
  <div class="wrap">
    <a class="mark" href="/">AKAY<b>.</b></a>

    <div class="code">404 — offer not found</div>
    <h1>This offer is no longer live.</h1>
    <p>
      AKAY's catalogue turns over constantly — offers sell out, expire, or are
      withdrawn as stock moves. The page you followed was a live offer at the
      time it was linked; it isn't any more.
    </p>

    <!-- Filled in client-side when this URL matches a known retired offer. -->
    <div class="card" id="was" hidden>
      <h2>This URL used to be</h2>
      <p class="prod" id="was-name"></p>
      <p id="was-cat"></p>
      <a class="cta" id="was-link" href="/">See current stock</a>
    </div>

    <div class="card">
      <h2>Browse the live catalogue</h2>
      <p>Every offer below is current, with pack spec, duty tier and trade price on each line.</p>
      <ul class="cats">
        {CATEGORIES.map((c) => (
          <li><a href={`/category/${catSlug(c)}/`}>{c}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <a class="cta" href="/">All offers</a>
      <a class="cta alt" href="/guides/requirement-list-format/">How to order</a>
    </div>

    {guides.length > 0 && (
      <div class="card">
        <h2>Trade guides</h2>
        <ul class="cats">
          {guides.slice(0, 4).map((g) => (
            <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    <div class="foot">
      AKAY Trade · Shannon, Ireland — looking for something specific?
      <a href="mailto:offers@akay.ie">offers@akay.ie</a>
    </div>
  </div>

  <script is:inline>
    // Name the product that used to live at this URL. The lookup table is
    // fetched only on this page, so the 2,100-entry map never loads for a
    // normal visitor. Any failure just leaves the category list showing.
    (function () {
      var m = location.pathname.match(/^\/offers\/([^/]+)\/?$/);
      if (!m) return;
      var slug = decodeURIComponent(m[1]);
      fetch('/retired-offers.json')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (map) {
          var hit = map && map[slug];
          if (!hit) return;
          var name = hit[0], cat = hit[1] || '';
          var catSlug = cat.toLowerCase().replace(/\s+/g, '-');
          document.getElementById('was-name').textContent = name;
          document.getElementById('was-cat').textContent = cat
            ? 'Listed under ' + cat + '. We often carry the same line again — current ' +
              cat.toLowerCase() + ' stock is below.'
            : 'We often carry the same line again.';
          if (cat) {
            var a = document.getElementById('was-link');
            a.href = '/category/' + catSlug + '/';
            a.textContent = 'Current ' + cat + ' offers';
          }
          document.getElementById('was').hidden = false;
        })
        .catch(function () {});
    })();
  </script>
</body>
</html>
