---
import { getOffers, getSiteStats } from '../data/airtable.mjs';
import { organizationSchema, websiteSchema } from '../lib/schema.mjs';
import Seo from '../components/Seo.astro';
import { withSlugs, categorySlug, brandPages } from '../lib/slug.mjs';
import { guides } from '../data/guides.mjs';
import { enquiryLink, WA_LINK, WA_DISPLAY, SELL_STOCK_LINK } from '../lib/whatsapp.mjs';
import { listingTermsLine } from '../lib/trade-terms.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { quoteUrl, CRO_NUMBER, VAT_NUMBER, BUYING_EMAIL } from '../lib/site.mjs';
// The Instant Quote explainer (the .iq section below) and the /instant-quote/
// landing page show the same walkthrough, so the asset is named in one place.
import { QUOTE_VIDEO, QUOTE_VIDEO_POSTER, QUOTE_LANDING_PATH } from '../lib/quote-video.mjs';

const { offers: rawOffers, source } = await getOffers();
// Headline figures maintained in Airtable's "Site Stats" table (currently the
// EUR value of listed stock). Read verbatim, keyed by Stat Key; a key that is
// unpublished, empty or unreachable is simply absent from the map.
const { stats: siteStats } = await getSiteStats();

// Slugs come from the shared helper so every card links to a page the build
// actually generated (see src/lib/slug.mjs). Analytics and the rest of the
// <head> live in the shared <Seo> component.
const offers = withSlugs(rawOffers);

// ---- derive per-offer view data (basis split so the price never repeats) ----
function priceParts(detail = '') {
  const parts = detail.split('·').map((s) => s.trim());
  const first = parts[0] || '';
  const basis = /\/\s*bottle/i.test(first) ? '/ btl'
    : /\/\s*case/i.test(first) ? '/ case'
    : /\/\s*unit/i.test(first) ? '/ unit' : '';
  const msg = basis === '/ btl' ? 'per bottle' : basis === '/ case' ? 'per case' : basis === '/ unit' ? 'per unit' : '';
  const other = parts.slice(1).join(' · ');
  return { basis, other, msg };
}
const STOCK = { in: ['ok', 'In stock'], warn: ['warn', 'Limited'], enq: ['neu', 'Enquire'] };

function toView(o) {
  const { basis, other, msg } = priceParts(o.priceDetail);
  // tradeTerms: the shared "MOQ … · Lead … · N cases/pallet" wording the
  // category and brand grids use.
  return { ...o, basis, other, wa: enquiryLink(o, msg), st: STOCK[o.stock] || STOCK.enq, tradeTerms: listingTermsLine(o) };
}
const view = offers.map(toView);
// The homepage shows a short list, not the catalogue. It used to render every
// live offer — 10,000+ cards and a 16 MB HTML file, which a phone on mobile
// data had to download before the page settled. The full list lives at
// /search/ (loaded on demand, with filters) and on the category pages; this
// grid is the shop window: Featured lines first, then in-stock lines with the
// most cases, then the rest, in catalogue order within each group.
const HOME_LIMIT = 48;
const rank = (o) => (o.featured ? 0 : o.stock === 'in' ? 1 : o.stock === 'warn' ? 2 : 3);
const gridItems = view
  .map((o, i) => [o, i])
  .sort(([a, ia], [b, ib]) => rank(a) - rank(b) || (rank(a) === 1 ? (b.qty || 0) - (a.qty || 0) : 0) || ia - ib)
  .slice(0, HOME_LIMIT)
  .map(([o]) => o);
const inStockCount = view.filter((o) => o.stock === 'in').length;

const categories = ['All', ...Array.from(new Set(view.map((o) => o.category))).sort()];
// Real <a> links to the category pages. The filter chips above are buttons
// (client-side filtering), so without these the /category/ pages — and the
// 6,000 offer pages behind them — would have no crawlable path in.
const categoryLinks = categories
  .filter((c) => c !== 'All')
  .map((c) => ({ name: c, href: `/category/${categorySlug(c)}/`, count: view.filter((o) => o.category === c).length }));
const brandCount = new Set(view.map((o) => o.brand)).size;
// Brand landing pages (live stock, 2+ offers). The most-stocked two dozen get
// homepage links; the /brands/ hub carries the rest, so every brand page has
// a crawlable path from here.
const allBrandPages = brandPages(offers);
const topBrands = [...allBrandPages].sort((a, b) => b.offers.length - a.offers.length).slice(0, 24);

const fmt = (n) => n.toLocaleString('en-IE');
const stats = [
  [fmt(view.length), 'live offers'],
  // Value of listed stock, e.g. "Over €60 million" — a banded floor, so the
  // wording is printed exactly as stored, with no timestamp beside it. When
  // the stat is absent the row simply has one fewer figure: never €0, never
  // a placeholder slot.
  ...(siteStats.stock_value_eur ? [[siteStats.stock_value_eur, 'stock listed']] : []),
  [fmt(brandCount), 'brands'],
  [fmt(inStockCount), 'lines in stock now'],
];
---

<!doctype html>
<html lang="en" data-source={source}>
<head>
  <Seo
    title="Wholesale Drinks &amp; Spirits Supplier, Ireland — Live Trade Offers | AKAY Trade"
    description="AKAY Trade is an Irish wholesale drinks and FMCG supplier. Thousands of live trade offers on spirits, beer, wine, soft drinks and grocery by the case and pallet — current pricing, pack specs and T1/T2 duty status on every line."
    ogTitle="AKAY Trade — Live Wholesale Beverage Offers"
    path="/"
    schemas={[organizationSchema(), websiteSchema()]}
  />
  {/* is:global — scoped styles would stamp a data-astro-cid attribute on
      every element of every card. The shared header and footer use prefixed
      class names (sh-, sf-) so nothing here collides with them. Design
      tokens come from src/styles/tokens.css via SiteHeader. */}
  <style is:global>
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}
    .wrap{max-width:1200px;margin:0 auto;padding:0 20px}

    .hero{border-bottom:1px solid var(--line);background:
      radial-gradient(120% 140% at 100% 0,color-mix(in srgb,var(--forest) 12%,transparent),transparent 55%),
      radial-gradient(90% 120% at 0 100%,color-mix(in srgb,var(--brass) 7%,transparent),transparent 60%)}
    .hero-in{padding-top:40px;padding-bottom:32px;display:grid;gap:28px 48px;
      grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);align-items:center}
    @media (max-width:900px){.hero-in{grid-template-columns:1fr}}
    .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);margin:0 0 12px}
    h1{font-family:var(--serif);font-weight:600;font-size:clamp(30px,4.6vw,50px);line-height:1.04;margin:0;max-width:16ch;text-wrap:balance;letter-spacing:-.01em}
    .lede{margin:14px 0 0;max-width:56ch;color:var(--ink-soft);font-size:16px}
    /* The Instant Quote button. Brass rather than forest so it reads as the
       primary action on the page. */
    .cta-quote{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 22px;border-radius:12px;
      background:var(--brass);color:#fff;font-weight:600;font-size:15.5px;line-height:1;text-decoration:none;
      border:1px solid transparent;box-shadow:var(--shadow);transition:background .14s,transform .14s}
    .cta-quote:hover{background:var(--forest);transform:translateY(-1px)}
    .cta-quote:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
    .cta-quote svg{flex-shrink:0;width:19px;height:19px}
    /* Dark palettes lighten --brass, so flip the label to ink to keep contrast. */
    @media (prefers-color-scheme:dark){.cta-quote{color:#17140F}}
    :root[data-theme="dark"] .cta-quote{color:#17140F}
    :root[data-theme="light"] .cta-quote{color:#fff}
    @media (prefers-reduced-motion:reduce){.cta-quote{transition:none}.cta-quote:hover{transform:none}}
    @media (max-width:520px){.cta-quote{width:100%;justify-content:center;padding:0 16px}}
    .hero-cta{display:flex;flex-wrap:wrap;gap:10px 12px;margin-top:22px}
    /* Secondary action: outline, so the upload button stays the one to press. */
    .cta-ghost{display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 20px;border-radius:12px;
      border:1px solid var(--ink);color:var(--ink);background:transparent;font-weight:600;font-size:15px;text-decoration:none;transition:.14s}
    .cta-ghost:hover{background:var(--ink);color:var(--paper)}
    .cta-ghost:focus-visible{outline:2px solid var(--brass-2);outline-offset:3px}
    @media (max-width:520px){.cta-ghost{width:100%}}
    .ticker{display:flex;flex-wrap:wrap;gap:14px 28px;margin-top:26px;padding-top:20px;border-top:1px solid var(--line-soft)}

    .sell{border-bottom:1px solid var(--line);background:var(--paper-2);scroll-margin-top:76px}
    .sell-in{padding-top:24px;padding-bottom:24px;display:grid;gap:18px 36px;grid-template-columns:minmax(0,1.4fr) auto;align-items:center}
    @media (max-width:820px){.sell-in{grid-template-columns:1fr}}
    .sell-eyebrow{margin:0 0 8px;font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);font-weight:bold}
    .sell h2{font-family:var(--serif);font-size:24px;font-weight:600;margin:0;color:var(--ink)}
    .sell-lede{margin:8px 0 0;max-width:62ch;color:var(--ink-soft);font-size:15px}
    .sell-list{margin:10px 0 0;max-width:62ch;color:var(--muted);font-size:13px}
    .sell-list b{color:var(--ink-soft)}
    .sell-cta{display:flex;flex-direction:column;gap:10px;min-width:250px}
    .sell-wa{display:inline-flex;align-items:center;justify-content:center;gap:9px;height:50px;padding:0 20px;border-radius:12px;
      background:var(--forest);color:var(--paper);font-weight:600;font-size:15px;text-decoration:none;transition:background .14s}
    :root[data-theme="dark"] .sell-wa{color:#0A140F}
    @media (prefers-color-scheme:dark){.sell-wa{color:#0A140F}}
    .sell-wa:hover{background:var(--brass);color:#fff}
    .sell-wa:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
    @media (max-width:520px){.sell-cta{min-width:0}}
    .tline{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:10px;font-family:var(--mono);font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
    .tline span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    /* Trust strip: registration facts and what every line carries. */
    .trust{border-bottom:1px solid var(--line);background:var(--card)}
    .trust-in{list-style:none;margin:0 auto;padding-top:16px;padding-bottom:16px;display:grid;gap:12px 20px;
      grid-template-columns:repeat(4,minmax(0,1fr));font-size:13px;line-height:1.4}
    @media (max-width:960px){.trust-in{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media (max-width:560px){.trust-in{grid-template-columns:repeat(2,minmax(0,1fr))}}
    .trust-in b{display:block;color:var(--ink);font-weight:600}
    .trust-in span{color:var(--muted);font-family:var(--mono);font-size:12px}
    .trust-in a{color:var(--brass);text-decoration:none;font-weight:600}
    .trust-in a:hover{text-decoration:underline}
    .stat .n{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
    .stat .l{font-size:12px;color:var(--muted);letter-spacing:.03em}

    /* ── Instant Quote ─────────────────────────────────────────────────
       The site's USP. Its explainer banner sits in the hero, so this band
       carries the three steps side by side and the call to action. The
       banner is plain HTML/CSS rather than a video: nothing to host, nothing
       to download, and it renders with JS off. Set QUOTE_VIDEO in
       src/lib/quote-video.mjs to swap in a real screen recording. */
    /* scroll-margin-top clears the sticky header when the hero link jumps here. */
    .iq{border-bottom:1px solid var(--line);scroll-margin-top:76px;background:
      radial-gradient(90% 140% at 0 0,color-mix(in srgb,var(--brass) 8%,transparent),transparent 58%),
      color-mix(in srgb,var(--forest) 5%,transparent)}
    .iq-in{padding-top:30px;padding-bottom:30px}
    .iq-eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 9px;font-family:var(--mono);font-size:11.5px;
      letter-spacing:.16em;text-transform:uppercase;color:var(--brass);font-weight:bold}
    .iq-eyebrow .new{background:var(--brass);color:#fff;border-radius:5px;padding:2px 7px;font-size:10px;letter-spacing:.1em}
    /* Dark palettes lighten --brass, so flip the label to ink to keep contrast. */
    @media (prefers-color-scheme:dark){.iq-eyebrow .new{color:#17140F}}
    :root[data-theme="dark"] .iq-eyebrow .new{color:#17140F}
    :root[data-theme="light"] .iq-eyebrow .new{color:#fff}
    .iq-copy h2{font-family:var(--serif);font-size:clamp(21px,2.7vw,28px);font-weight:600;margin:0;
      color:var(--ink);text-wrap:balance;letter-spacing:-.01em}
    .iq-lede{margin:9px 0 0;color:var(--ink-soft);font-size:14.5px;max-width:70ch}
    .iq-lede a{color:var(--brass);font-weight:600;text-decoration:none}
    .iq-lede a:hover{text-decoration:underline}
    .iq-steps{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:14px 24px;grid-template-columns:repeat(3,minmax(0,1fr))}
    @media (max-width:820px){.iq-steps{grid-template-columns:1fr}}
    .iq-steps li{display:flex;gap:11px;align-items:flex-start}
    .iq-n{flex-shrink:0;width:23px;height:23px;margin-top:1px;border-radius:50%;background:var(--forest);color:var(--paper);
      font-family:var(--mono);font-size:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center}
    :root[data-theme="dark"] .iq-n{color:#0A140F}
    @media (prefers-color-scheme:dark){.iq-n{color:#0A140F}}
    :root[data-theme="light"] .iq-n{color:var(--paper)}
    .iq-steps b{display:block;color:var(--ink);font-size:14px;font-weight:600}
    .iq-steps .t{display:block;color:var(--ink-soft);font-size:13.5px;line-height:1.5;max-width:54ch}
    .iq-steps .t strong{color:var(--ink);font-weight:600}
    .iq-cta{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-top:22px}
    .iq-alt{font-size:13px;color:var(--ink-soft);max-width:52ch}
    .iq-alt a{color:var(--brass);font-weight:600;text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--brass) 40%,transparent)}
    .iq-alt a:hover{color:var(--forest)}

    /* Explainer banner — the customer's own file with our price written into
       it. What they uploaded (product, their cost) sits static; what we add
       (our price, the saving) animates in beside it, which is the whole story
       in one picture. Figures are illustrative and captioned as such. */
    .iq-demo{margin:0;width:100%;max-width:480px;justify-self:end}
    @media (max-width:900px){.iq-demo{justify-self:stretch;max-width:none}}
    .iq-win{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
      box-shadow:var(--shadow);overflow:hidden}
    .iq-bar{display:flex;align-items:center;gap:7px;padding:10px 13px;border-bottom:1px solid var(--line-soft);
      background:color-mix(in srgb,var(--paper-2) 55%,var(--card))}
    .iq-bar i{width:8px;height:8px;border-radius:50%;background:var(--line)}
    .iq-bar .fn{margin-left:5px;font-family:var(--mono);font-size:11.5px;color:var(--muted);
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .iq-bar .tag{margin-left:auto;flex-shrink:0;font-family:var(--mono);font-size:9.5px;letter-spacing:.07em;
      background:var(--ok-bg);color:var(--ok);border-radius:5px;padding:3px 7px;font-weight:600}
    .iq-rows{padding:2px 13px 8px}
    /* Wraps to two lines rather than squeezing four columns onto a phone. */
    .iq-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:3px 10px;
      padding:10px 0;border-bottom:1px solid var(--line-soft);font-size:13px}
    .iq-row:last-child{border-bottom:0}
    .iq-row .nm{color:var(--ink);flex:1 1 auto;min-width:115px}
    /* Narrow enough that a long name would wrap on its own: stack every row
       the same way rather than letting only the long ones break. */
    @media (max-width:560px){.iq-row{justify-content:flex-start}.iq-row .nm{flex-basis:100%}}
    .iq-cmp{display:inline-flex;align-items:center;gap:7px;flex-shrink:0;
      font-family:var(--mono);font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap}
    .iq-cmp .was{color:var(--muted)}
    .iq-add{display:inline-flex;align-items:center;gap:7px;
      animation:iq-match .5s ease-out both;animation-delay:var(--d,0s)}
    .iq-add .arw{width:11px;height:11px;flex-shrink:0;color:var(--muted)}
    .iq-add .now{color:var(--ink);font-weight:600}
    .iq-add .sv{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:999px;
      background:var(--ok-bg);color:var(--ok);font-size:10.5px;font-weight:600}
    .iq-add .sv svg{width:9px;height:9px;flex-shrink:0}
    .iq-foot{display:flex;align-items:center;gap:7px;padding:10px 13px;border-top:1px solid var(--line-soft);
      background:color-mix(in srgb,var(--forest) 7%,var(--card));font-family:var(--mono);font-size:11.5px;color:var(--ok)}
    .iq-foot svg{width:13px;height:13px;flex-shrink:0}
    .iq-cap{margin:10px 2px 0;font-size:12.5px;color:var(--muted);line-height:1.5}
    .iq-cap a{color:var(--brass);font-weight:600;text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--brass) 40%,transparent)}
    .iq-cap a:hover{color:var(--forest)}
    /* The lines land one after another — the stagger is what reads as
       "matching". It plays once and settles rather than looping: indefinite
       motion with no pause control would fail WCAG 2.2.2, and the settled
       state tells the same story. With reduced motion it starts settled. */
    @keyframes iq-match{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion:reduce){.iq-row .pr{animation:none;opacity:1;transform:none}}
    /* Real recording, when one is dropped in */
    .iq-video{width:100%;display:block;border-radius:var(--radius);border:1px solid var(--line);box-shadow:var(--shadow);background:var(--card)}

    .feat-badge{align-self:flex-start;font-family:var(--mono);font-size:10px;font-weight:bold;letter-spacing:.08em;
      text-transform:uppercase;color:#fff;background:#B4231F;padding:3px 8px;border-radius:6px;margin-bottom:12px}
    .card.feat-on{border-color:color-mix(in srgb,var(--brass-2) 50%,var(--line))}

    main.wrap{scroll-margin-top:76px}
    .grid-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;margin:0 0 14px}
    .grid-head h2{font-family:var(--serif);font-size:clamp(22px,2.6vw,28px);font-weight:600;margin:0 0 4px;color:var(--ink)}
    .grid-head .count{margin:0}
    .count a{color:var(--brass);text-decoration:none;font-weight:600}
    .count a:hover{text-decoration:underline}
    .search{position:relative;flex:0 1 380px;min-width:240px;margin:0}
    .search input{width:100%;height:42px;border:1px solid var(--line);background:var(--card);color:var(--ink);
      border-radius:11px;padding:0 14px 0 40px;font-size:15px;font-family:var(--sans)}
    .search input:focus{outline:2px solid var(--brass-2);outline-offset:1px;border-color:transparent}
    .search svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted)}
    .chips{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 18px}
    .chip{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:999px;
      height:34px;padding:0 14px;font-size:13.5px;transition:.14s;white-space:nowrap;text-decoration:none}
    .chip:hover{border-color:var(--brass-2);color:var(--ink)}
    .chip-n{font-family:var(--mono);font-size:11px;color:var(--muted)}
    .see-all{text-align:center;margin:28px 0 0}

    main.wrap{padding:32px 20px 44px}
    .count{font-family:var(--mono);font-size:12.5px;color:var(--muted);margin:0 0 16px;letter-spacing:.03em}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;
      display:flex;flex-direction:column;gap:0;box-shadow:var(--shadow);transition:.16s;position:relative;overflow:hidden}
    .card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--brass-2) 55%,var(--line))}
    .card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--brass-2);opacity:0;transition:.16s}
    .card:hover::before{opacity:1}
    .c-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .brand{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--brass);margin-bottom:6px}
    .pname{font-family:var(--serif);font-size:19px;font-weight:600;line-height:1.15;margin:0;color:var(--ink);text-wrap:balance;
      display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    /* Variant lists live under the name so long assortments never blow up the card. */
    .variants{margin-top:5px;font-size:11.5px;line-height:1.35;color:var(--muted);font-family:var(--sans);
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .cat-tag{flex-shrink:0;font-size:10.5px;font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;
      color:var(--ink-soft);border:1px solid var(--line);border-radius:6px;padding:3px 7px;margin-top:2px}
    .spec{font-family:var(--mono);font-size:12.5px;color:var(--ink-soft);margin:12px 0 0;letter-spacing:.01em}
    .metaline{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
    .tag{font-size:11px;padding:3px 8px;border-radius:6px;font-family:var(--mono);letter-spacing:.03em;
      border:1px solid var(--line);color:var(--muted)}
    .tag.tier{border-color:color-mix(in srgb,var(--brass-2) 45%,var(--line));color:var(--brass)}
    .price-row{margin-top:16px;padding-top:14px;border-top:1px solid var(--line-soft);display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
    .price .amt{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1}
    .price .cur{font-size:12px;color:var(--muted);font-family:var(--mono)}
    .price .basis{font-size:12px;color:var(--muted);font-family:var(--mono);letter-spacing:.01em}
    .price .sub{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:5px;font-variant-numeric:tabular-nums}
    .pill{font-size:11px;font-weight:600;padding:4px 9px;border-radius:999px;white-space:nowrap;font-family:var(--sans)}
    .pill.ok{background:var(--ok-bg);color:var(--ok)}
    .pill.warn{background:var(--warn-bg);color:var(--warn)}
    .pill.neu{background:var(--neu-bg);color:var(--neu)}
    .stock{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
    .qty{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--ok);font-variant-numeric:tabular-nums;letter-spacing:.02em}
    .qty.muted{color:var(--muted);font-weight:400}
    .c-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:16px}
    .pname a{color:inherit;text-decoration:none}
    .pname a:hover{color:var(--brass);text-decoration:underline}
    .details{font-size:12.5px;font-weight:600;color:var(--brass);text-decoration:none;white-space:nowrap}
    .details:hover{text-decoration:underline}
    .catnav{border-top:1px solid var(--line);padding:36px 20px 30px;scroll-margin-top:76px}
    .catnav h2{font-family:var(--serif);font-size:24px;margin:0 0 8px;color:var(--ink)}
    .catnav-lede{color:var(--muted);margin:0 0 18px;font-size:14px}
    .catnav-list{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0}
    .catnav-list a{display:inline-flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);
      border-radius:999px;padding:8px 14px;font-size:14px;font-weight:600;color:var(--ink);text-decoration:none}
    .catnav-list a:hover{border-color:var(--brass);color:var(--brass)}
    .catnav-count{font-family:var(--mono);font-size:11.5px;font-weight:400;color:var(--muted)}
    .catnav-more{margin:20px 0 0;font-size:14px;color:var(--muted)}
    .catnav-more a{color:var(--brass);text-decoration:none}
    .catnav-more a:hover{text-decoration:underline}
    .incoterm{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
    .enquire{display:inline-flex;align-items:center;gap:7px;background:var(--forest);color:var(--paper);
      text-decoration:none;font-size:13px;font-weight:600;padding:8px 13px;border-radius:9px;transition:.14s;border:1px solid transparent}
    :root[data-theme="dark"] .enquire{color:#0A140F}
    @media (prefers-color-scheme:dark){.enquire{color:#0A140F}}
    .enquire:hover{background:var(--brass);color:#fff}
    
    .guides{border-top:1px solid var(--line);padding:40px 0;background:var(--paper-2);scroll-margin-top:76px}
    .guides h2{font-family:var(--serif);font-size:24px;margin:0 0 8px}
    .guides h2 a{color:var(--ink);text-decoration:none}
    .guides .catnav-lede a{color:var(--brass);text-decoration:none}
    .guide-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
    .guide-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;text-decoration:none;
      transition:.16s;display:flex;flex-direction:column}
    .guide-card:hover{border-color:color-mix(in srgb,var(--brass-2) 55%,var(--line))}
    .guide-card h3{margin:0 0 8px;font-size:16px;font-family:var(--serif);font-weight:600;color:var(--ink);line-height:1.3}
    .guide-card p{margin:0;color:var(--muted);font-size:14px;flex-grow:1}
    .guide-card span{color:var(--brass);font-size:13px;font-weight:600;margin-top:12px}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
    @media (max-width:560px){.hero-in{padding-top:26px;padding-bottom:20px}.ticker{gap:18px}}
  </style>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-wa" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5.2.6.8 2 .9 2.1.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1l1.8.9c.3.1.5.2.5.3.1.2.1.7-.1 1.4Z"/></symbol>
  </svg>

  <SiteHeader />

  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">Wholesale FMCG · spirits · beer · T1 export &amp; T2 duty-paid</p>
        <h1>Live trade pricing, straight from the desk.</h1>
        <p class="lede">Spirits, beer, soft drinks, toiletries and grocery by the case and pallet — {fmt(view.length)} live offers from {fmt(brandCount)} brands, with pack, duty status, Incoterm and stock on every line. No login to see prices.</p>
        <div class="hero-cta">
          <a class="cta-quote" href={quoteUrl('excel')} rel="nofollow">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 15.5V3.5m0 0L7.8 7.7M12 3.5l4.2 4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 15.5V18a2.5 2.5 0 0 0 2.5 2.5h11A2.5 2.5 0 0 0 20 18v-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Upload your list — get it priced
          </a>
          <a class="cta-ghost" href="/search/">Browse all {fmt(view.length)} offers</a>
        </div>
        <div class="ticker">
          {stats.map((s) => (
            <div class="stat"><div class="n">{s[0]}</div><div class="l">{s[1]}</div></div>
          ))}
        </div>
      </div>

      <figure class="iq-demo">
        {QUOTE_VIDEO ? (
          /* Play on tap, not on load: autoplay would spend a phone's data
             before anyone asked, and looping motion with no pause control
             fails WCAG 2.2.2. */
          <video class="iq-video" src={QUOTE_VIDEO} poster={QUOTE_VIDEO_POSTER} width="460" height="300"
                 controls muted playsinline preload="none"
                 aria-label="Screen recording: a buying list uploaded to the Instant Quote tool and downloaded back with our prices and the savings marked."></video>
        ) : (
          /* aria-hidden: it's a picture of the Instant Quote steps spelled out
             below, so a screen reader gets the caption instead of a mock
             table. The figures are made up — generic product types, never a
             real line — and the caption says so. */
          <div class="iq-win" aria-hidden="true">
            <div class="iq-bar"><i></i><i></i><i></i><span class="fn">my-buying-list.xlsx</span><span class="tag">+ AKAY PRICE</span></div>
            <div class="iq-rows">
              {[['Irish whiskey · 12 × 70cl', '142.00', '131.50', '7%', '.1s'],
                ['Lager · 24 × 330ml can', '21.40', '19.95', '7%', '.55s'],
                ['Vodka · 6 × 1L', '78.00', '74.25', '5%', '1s']].map(([nm, was, now, save, d]) => (
                <div class="iq-row">
                  <span class="nm">{nm}</span>
                  <span class="iq-cmp">
                    <span class="was">€{was}</span>
                    <span class="iq-add" style={`--d:${d}`}>
                      <svg class="arw" viewBox="0 0 24 24" fill="none"><path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span class="now">€{now}</span>
                      <span class="sv">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v15m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {save}
                      </span>
                    </span>
                  </span>
                </div>
              ))}
            </div>
            <div class="iq-foot">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              3 of 3 lines priced · ready to download
            </div>
          </div>
        )}
        <figcaption class="iq-cap">Example figures. Your own file comes back with our live selling price written in beside your cost, and the saving worked out on every line. <a href="#instant-quote">How it works ↓</a></figcaption>
      </figure>
    </div>
  </section>

  {/* Only facts that can be checked: company registration, and what the
      catalogue itself shows on every line. Add a claim here only once it is
      true for every deal. */}
  <section class="trust" aria-label="About AKAY Trade">
    <ul class="wrap trust-in">
      <li><b>Irish registered company</b><span>CRO {CRO_NUMBER}</span></li>
      <li><b>EU VAT registered</b><span>{VAT_NUMBER}</span></li>
      <li><b>T1 export &amp; T2 duty-paid</b><span>duty status on every line</span></li>
      <li><b>Prices in public</b><span>no login, no PDF</span></li>
      <li><b>Principal trader</b><span>we buy the stock and invoice you</span></li>
      <li><b>Safe payment</b><span><a href="/guides/escrow-payment-wholesale-spirits/">escrow</a>, or 30% with order and the balance against a copy of the BL</span></li>
      <li><b>Pre-shipment photos</b><span>of your goods, before they ship</span></li>
      <li><b>Talk to a trader</b><span><a href={WA_LINK} target="_blank" rel="noopener">WhatsApp</a> or <a href="mailto:offers@akay.ie">email</a></span></li>
    </ul>
  </section>

  <section class="iq" id="instant-quote">
    <div class="wrap iq-in">
      <div class="iq-copy">
        <p class="iq-eyebrow"><span class="new">New</span> Instant Quote</p>
        <h2>Send your list in any format. Get it back priced.</h2>
        <p class="iq-lede">No rep, no callback, no template to fill in. Upload the list exactly as you already keep it — we read it, write our selling price into it, and hand it straight back to download. <a href={QUOTE_LANDING_PATH}>See how it works</a>.</p>
      </div>
      <ol class="iq-steps">
        <li>
          <span class="iq-n" aria-hidden="true">1</span>
          <div><b>Upload it however you have it</b><span class="t">Excel, CSV, or whatever your buying list already looks like. No fixed columns and no template — we parse it as it comes.</span></div>
        </li>
        <li>
          <span class="iq-n" aria-hidden="true">2</span>
          <div><b>We price it against live stock</b><span class="t">Every line is matched against the {fmt(view.length)} offers live on this site right now — by barcode, brand and pack size — and our selling price goes straight into your own file.</span></div>
        </li>
        <li>
          <span class="iq-n" aria-hidden="true">3</span>
          <div><b>Download it back — with your savings</b><span class="t">Include your current cost or target price and we mark the difference on every line, so what you save is there in black and white.</span></div>
        </li>
      </ol>
      <div class="iq-cta">
        <a class="cta-quote" href={quoteUrl('excel')} rel="nofollow">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 15.5V3.5m0 0L7.8 7.7M12 3.5l4.2 4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 15.5V18a2.5 2.5 0 0 0 2.5 2.5h11A2.5 2.5 0 0 0 20 18v-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Upload your list — download it priced
        </a>
        <span class="iq-alt">Rather use email? Send it to <a href="mailto:offers@akay.ie?subject=Requirement%20List">offers@akay.ie</a> with "Requirement List" in the subject — any format, same automatic pricing.</span>
      </div>
    </div>
  </section>

  {/* The other half of the market: we are a trader, so we buy as well as sell. */}
  <section class="sell" id="sell-stock" aria-labelledby="sell-h">
    <div class="wrap sell-in">
      <div>
        <p class="sell-eyebrow">For suppliers</p>
        <h2 id="sell-h">Have stock to sell? We buy.</h2>
        <p class="sell-lede">We buy branded spirits, beer, HPC, grocery and confectionery as principal, T1 or T2. Send your offer list in any format and our buying desk replies directly.</p>
        <p class="sell-list"><b>Include:</b> brand and product · pack and size · quantity · location and Incoterm · T1/T2 · BBD · your price</p>
      </div>
      <div class="sell-cta">
        <a class="sell-wa" href={SELL_STOCK_LINK} target="_blank" rel="noopener">
          <svg width="16" height="16" aria-hidden="true"><use href="#i-wa" /></svg>
          WhatsApp {WA_DISPLAY}
        </a>
        <a class="cta-ghost" href={`mailto:${BUYING_EMAIL}?subject=${encodeURIComponent('Stock offer')}`}>Email {BUYING_EMAIL}</a>
      </div>
    </div>
  </section>

  <main class="wrap" id="offers">
    <div class="grid-head">
      <div>
        <h2>Featured &amp; in stock now</h2>
        <p class="count">{gridItems.length} of {fmt(view.length)} live offers · <a href="/search/">search &amp; filter all of them →</a></p>
      </div>
      <form class="search" action="/search/" method="get" role="search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input name="q" type="search" placeholder="Search all offers — brand, product or barcode" aria-label="Search all offers" autocomplete="off" />
      </form>
    </div>
    <nav class="chips" aria-label="Shop by category">
      {categoryLinks.map((c) => (
        <a class="chip" href={c.href}>{c.name} <span class="chip-n">{fmt(c.count)}</span></a>
      ))}
    </nav>
    <div class="grid" id="grid">
      {gridItems.map((o) => (
        <article class={`card${o.featured ? ' feat-on' : ''}`}>
          {o.featured && <span class="feat-badge">★ Featured</span>}
          <div class="c-top">
            <div>
              <div class="brand">{o.brand}</div>
              <h3 class="pname"><a href={`/offers/${o.slug}/`} title={o.name}>{o.name}</a></h3>
              {o.variants && <div class="variants" title={o.variants}>{o.variants}</div>}
            </div>
            <span class="cat-tag">{o.category}</span>
          </div>
          <div class="spec">{o.spec}</div>
          <div class="metaline">
            {o.tier && <span class="tag tier">{o.tier}</span>}
            {o.origin && <span class="tag">{o.origin}</span>}
          </div>
          {(o.tradeTerms || o.ean) && (
            <div class="tline">
              {o.tradeTerms && <span title={o.tradeTerms}>{o.tradeTerms}</span>}
              {o.ean && <span>EAN {o.ean}</span>}
            </div>
          )}
          <div class="price-row">
            <div class="price">
              <div><span class="cur">{o.currency}</span> <span class="amt">{o.amount != null ? o.amount.toFixed(2) : '—'}</span> <span class="basis">{o.basis}</span></div>
              {o.other && <div class="sub">{o.other}</div>}
            </div>
            <div class="stock">
              <span class={`pill ${o.st[0]}`}>{o.st[1]}</span>
              {o.qty ? <span class="qty" title="Cases available">{o.qty.toLocaleString('en-IE')} cases</span> : <span class="qty muted">on request</span>}
            </div>
          </div>
          <div class="c-foot">
            <a class="details" href={`/offers/${o.slug}/`}>Details</a>
            <span class="incoterm">{o.terms || 'Terms on enquiry'}</span>
            <a class="enquire" href={o.wa} target="_blank" rel="noopener"
               data-offer={o.name} data-brand={o.brand} data-category={o.category}
               data-currency={o.currency} data-amount={o.amount}>
              <svg width="14" height="14" aria-hidden="true"><use href="#i-wa" /></svg>
              Enquire
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="see-all"><a class="cta-ghost" href="/search/">See all {fmt(view.length)} offers with filters →</a></p>
  </main>

  <section id="categories" class="catnav">
    <div class="wrap">
      <h2>Browse by category</h2>
      <p class="catnav-lede">Every category has its own page with the full live list, trade pricing and duty status.</p>
      <nav aria-label="Offer categories">
        <ul class="catnav-list">
          {categoryLinks.map((c) => (
            <li><a href={c.href}>{c.name}<span class="catnav-count">{fmt(c.count)}</span></a></li>
          ))}
        </ul>
      </nav>
      <h2 style="margin-top:34px">Browse by brand</h2>
      <p class="catnav-lede">The most-stocked brands, each with its own wholesale landing page.</p>
      <nav aria-label="Brand pages">
        <ul class="catnav-list">
          {topBrands.map((b) => (
            <li><a href={`/brands/${b.slug}/`}>{b.brand}<span class="catnav-count">{b.offers.length}</span></a></li>
          ))}
          <li><a href="/brands/">All brands A–Z</a></li>
        </ul>
      </nav>
      <p class="catnav-more">
        New to trade buying? Read <a href="/guides/t1-vs-t2-duty-status/">T1 vs T2 duty status</a>,
        <a href="/guides/incoterms-exw-dap-cfr/">Incoterms explained</a> and
        <a href="/guides/how-to-buy-wholesale-spirits-eu/">how to buy wholesale in the EU</a>,
        or read more <a href="/about/">about AKAY Trade</a>.
      </p>
    </div>
  </section>

  <section id="guides" class="guides">
    <div class="wrap">
      <h2><a href="/guides/">Buyer's guides</a></h2>
      <p class="catnav-lede">Guides for wholesale buyers: duty status, shipping terms, how to order. <a href="/guides/">See all guides →</a></p>
      <div class="guide-grid">
        {guides.map((guide) => (
          <a class="guide-card" href={`/guides/${guide.slug}/`}>
            <h3>{guide.title}</h3>
            <p>{guide.excerpt}</p>
            <span>Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />

  <script>
    // GA4: record which offers drive WhatsApp enquiries.
    document.getElementById('grid')?.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('a.enquire') as HTMLAnchorElement | null;
      if (!a || typeof (window as any).gtag !== 'function') return;
      const amt = parseFloat(a.dataset.amount || '');
      (window as any).gtag('event', 'whatsapp_enquiry', {
        offer_name: a.dataset.offer,
        brand: a.dataset.brand,
        category: a.dataset.category,
        currency: a.dataset.currency || undefined,
        value: Number.isFinite(amt) ? amt : undefined,
      });
    });

    // Deep links: akay.ie/#spirits (or #beer, #grocery …) used to preselect a
    // filter chip on the old all-offers homepage. Email signatures and shared
    // links still use them, so send them to that category's own page. Page
    // anchors (#instant-quote, #categories, …) are left alone.
    const CATEGORY_PAGES: Record<string, string> = JSON.parse(
      document.getElementById('cat-map')?.textContent || '{}'
    );
    const hashCat = decodeURIComponent(location.hash.slice(1)).trim().toLowerCase();
    if (hashCat && CATEGORY_PAGES[hashCat]) location.replace(CATEGORY_PAGES[hashCat]);
  </script>
  <script type="application/json" id="cat-map" set:html={JSON.stringify(Object.fromEntries(categoryLinks.map((c) => [c.name.toLowerCase(), c.href])))} />
</body>
</html>
