---
import { getOffers } from '../data/airtable.mjs';
import { organizationSchema, websiteSchema } from '../lib/schema.mjs';
import Seo from '../components/Seo.astro';
import { withSlugs, categorySlug } from '../lib/slug.mjs';
import { guides } from '../data/guides.mjs';
import { enquiryLink, WA_LINK } from '../lib/whatsapp.mjs';
import SiteSearch from '../components/SiteSearch.astro';

const { offers: rawOffers, source } = await getOffers();

// Slugs come from the shared helper so every card links to a page the build
// actually generated (see src/lib/slug.mjs). Analytics and the rest of the
// <head> live in the shared <Seo> component.
const offers = withSlugs(rawOffers);

// ---- derive per-offer view data (basis split so the price never repeats) ----
function priceParts(detail = '') {
  const parts = detail.split('·').map((s) => s.trim());
  const first = parts[0] || '';
  const basis = /\/\s*bottle/i.test(first) ? '/ btl'
    : /\/\s*case/i.test(first) ? '/ case'
    : /\/\s*unit/i.test(first) ? '/ unit' : '';
  const msg = basis === '/ btl' ? 'per bottle' : basis === '/ case' ? 'per case' : basis === '/ unit' ? 'per unit' : '';
  const other = parts.slice(1).join(' · ');
  return { basis, other, msg };
}
const STOCK = { in: ['ok', 'In stock'], warn: ['warn', 'Limited'], enq: ['neu', 'Enquire'] };

function toView(o) {
  const { basis, other, msg } = priceParts(o.priceDetail);
  return { ...o, basis, other, wa: enquiryLink(o, msg), st: STOCK[o.stock] || STOCK.enq };
}
const view = offers.map(toView);
// Pin Featured offers to the front of the catalogue; stable sort keeps original order otherwise.
const gridItems = [...view].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
const featuredCount = view.filter((o) => o.featured).length;

const categories = ['All', ...Array.from(new Set(view.map((o) => o.category))).sort()];
// Real <a> links to the category pages. The filter chips above are buttons
// (client-side filtering), so without these the /category/ pages — and the
// 6,000 offer pages behind them — would have no crawlable path in.
const categoryLinks = categories
  .filter((c) => c !== 'All')
  .map((c) => ({ name: c, href: `/category/${categorySlug(c)}/`, count: view.filter((o) => o.category === c).length }));
const brandCount = new Set(view.map((o) => o.brand)).size;
const currencies = Array.from(new Set(view.map((o) => o.currency).filter(Boolean))).sort();
// Instant Quote explainer (the .iq section below). Point QUOTE_VIDEO at an
// MP4/WebM — put it in public/ and use an absolute path like
// '/instant-quote.mp4' — to replace the animated banner with a real screen
// recording; QUOTE_VIDEO_POSTER is the still frame shown before it plays.
// Left null, the CSS banner renders instead: no asset to host, no extra bytes.
const QUOTE_VIDEO = null;
const QUOTE_VIDEO_POSTER = null;

const stats = [
  [view.length, 'live offers'],
  [categories.length - 1, 'categories'],
  [currencies.join(' / ') || '—', 'currencies'],
  [brandCount, 'brands'],
];
---

<!doctype html>
<html lang="en" data-source={source}>
<head>
  <Seo
    title="Wholesale Spirits, Beer &amp; FMCG Offers — Live Trade Pricing | AKAY Trade"
    description="Live wholesale beverage and FMCG offers from AKAY Trade, Ireland. Spirits, beer, soft drinks and grocery by the case and pallet — current trade pricing, pack specs and T1/T2 duty status on every line."
    ogTitle="AKAY Trade — Live Wholesale Beverage Offers"
    path="/"
    schemas={[organizationSchema(), websiteSchema()]}
  />
  {/* is:global — scoped styles would stamp a data-astro-cid attribute on
      every element of all 6,098 cards, adding megabytes to the HTML. This
      page renders a whole document, so nothing else can collide. */}
  <style is:global>
    :root{
      --paper:#F7F5F0; --paper-2:#EFEDE4; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --line-soft:#ECE8DD;
      --brass:#B4231F; --brass-2:#D0362E; --forest:#0E7A3B; --lime:#6FA82E;
      --ok:#0E7A3B; --ok-bg:#E2F0E5; --warn:#9A6A12; --warn-bg:#F5E9CE; --neu:#5C6A78; --neu-bg:#E9ECEF;
      --shadow:0 1px 2px rgba(20,33,26,.06),0 6px 20px -8px rgba(20,33,26,.14);
      --radius:14px;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      --mono:ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme:dark){
      :root{
        --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
        --muted:#8A968A; --line:#243029; --line-soft:#1B2620;
        --brass:#EC5A52; --brass-2:#F26E66; --forest:#37B866; --lime:#9BD84F;
        --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
        --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
      }
    }
    :root[data-theme="light"]{
      --paper:#F7F5F0; --paper-2:#EFEDE4; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --line-soft:#ECE8DD; --brass:#B4231F; --brass-2:#D0362E; --forest:#0E7A3B; --lime:#6FA82E;
      --ok:#0E7A3B; --ok-bg:#E2F0E5; --warn:#9A6A12; --warn-bg:#F5E9CE; --neu:#5C6A78; --neu-bg:#E9ECEF;
    }
    :root[data-theme="dark"]{
      --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
      --muted:#8A968A; --line:#243029; --line-soft:#1B2620; --brass:#EC5A52; --brass-2:#F26E66; --forest:#37B866; --lime:#9BD84F;
      --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
    }
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}
    .wrap{max-width:1200px;margin:0 auto;padding:0 20px}

    header.bar{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--paper) 86%,transparent);
      backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
    .bar-in{display:flex;align-items:center;gap:16px;height:60px}
    .mark{display:inline-flex;align-items:center;gap:9px;font-family:var(--serif);font-weight:600;font-size:26px;letter-spacing:.02em;color:var(--ink);text-decoration:none;line-height:1}
    .logo-slot{flex-shrink:0;height:34px;width:auto;filter:drop-shadow(0 1px 2px rgba(0,0,0,.18))}
    .mark b{color:var(--brass)}
    .dot{width:6px;height:6px;border-radius:50%;background:var(--brass-2);display:inline-block;margin:0 2px 2px 2px}
    .bar-sub{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:.04em}
    @media (max-width:640px){.bar-sub{display:none}}
    .bar-spacer{flex:1}
    .theme-btn{border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:9px;
      height:34px;padding:0 12px;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
    .theme-btn:hover{border-color:var(--brass-2);color:var(--ink)}

    .hero{border-bottom:1px solid var(--line);background:
      radial-gradient(120% 140% at 100% 0,color-mix(in srgb,var(--forest) 12%,transparent),transparent 55%),
      radial-gradient(90% 120% at 0 100%,color-mix(in srgb,var(--brass) 7%,transparent),transparent 60%)}
    .hero-in{padding-top:34px;padding-bottom:26px}
    .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);margin:0 0 12px}
    h1{font-family:var(--serif);font-weight:600;font-size:clamp(30px,5vw,46px);line-height:1.04;margin:0;max-width:16ch;text-wrap:balance;letter-spacing:-.01em}
    .lede{margin:14px 0 0;max-width:56ch;color:var(--ink-soft);font-size:16px}
    /* Hero CTA → the Excel / AI quote matcher at quote.akay.ie. Brass rather
       than forest so it reads as the primary action and doesn't echo the
       green category-request button further down the page. */
    .hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px;margin-top:22px}
    .cta-quote{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 22px;border-radius:12px;
      background:var(--brass);color:#fff;font-weight:600;font-size:15.5px;line-height:1;text-decoration:none;
      border:1px solid transparent;box-shadow:var(--shadow);transition:background .14s,transform .14s}
    .cta-quote:hover{background:var(--forest);transform:translateY(-1px)}
    .cta-quote:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
    .cta-quote svg{flex-shrink:0;width:19px;height:19px}
    .cta-note{font-size:13.5px;color:var(--ink-soft);max-width:42ch}
    /* Dark palettes lighten --brass, so flip the label to ink to keep contrast. */
    @media (prefers-color-scheme:dark){.cta-quote{color:#17140F}}
    :root[data-theme="dark"] .cta-quote{color:#17140F}
    :root[data-theme="light"] .cta-quote{color:#fff}
    @media (prefers-reduced-motion:reduce){.cta-quote{transition:none}.cta-quote:hover{transform:none}}
    @media (max-width:520px){.cta-quote{width:100%;justify-content:center;padding:0 16px}}
    .ticker{display:flex;flex-wrap:wrap;gap:26px;margin-top:24px;padding-top:20px;border-top:1px solid var(--line-soft)}
    .stat .n{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
    .stat .l{font-size:12px;color:var(--muted);letter-spacing:.03em}

    /* ── Instant Quote ─────────────────────────────────────────────────
       The site's USP, in the slot the category-email form used to hold.
       Copy on the left, an explainer banner on the right. The banner is
       plain HTML/CSS rather than a video: nothing to host, nothing to
       download, and it renders with JS off. Set QUOTE_VIDEO in the
       frontmatter to swap in a real screen recording instead. */
    .iq{border-bottom:1px solid var(--line);background:
      radial-gradient(90% 140% at 0 0,color-mix(in srgb,var(--brass) 8%,transparent),transparent 58%),
      color-mix(in srgb,var(--forest) 5%,transparent)}
    .iq-in{padding-top:26px;padding-bottom:28px;display:grid;gap:24px 36px;
      grid-template-columns:minmax(320px,1.05fr) minmax(290px,.95fr);align-items:center}
    @media (max-width:900px){.iq-in{grid-template-columns:1fr}}
    .iq-eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 9px;font-family:var(--mono);font-size:11.5px;
      letter-spacing:.16em;text-transform:uppercase;color:var(--brass);font-weight:bold}
    .iq-eyebrow .new{background:var(--brass);color:#fff;border-radius:5px;padding:2px 7px;font-size:10px;letter-spacing:.1em}
    /* Dark palettes lighten --brass, so flip the label to ink to keep contrast. */
    @media (prefers-color-scheme:dark){.iq-eyebrow .new{color:#17140F}}
    :root[data-theme="dark"] .iq-eyebrow .new{color:#17140F}
    :root[data-theme="light"] .iq-eyebrow .new{color:#fff}
    .iq-copy h2{font-family:var(--serif);font-size:clamp(21px,2.7vw,28px);font-weight:600;margin:0;
      color:var(--ink);text-wrap:balance;letter-spacing:-.01em}
    .iq-lede{margin:9px 0 0;color:var(--ink-soft);font-size:14.5px;max-width:58ch}
    .iq-steps{list-style:none;margin:17px 0 0;padding:0;display:grid;gap:11px}
    .iq-steps li{display:flex;gap:11px;align-items:flex-start}
    .iq-n{flex-shrink:0;width:23px;height:23px;margin-top:1px;border-radius:50%;background:var(--forest);color:var(--paper);
      font-family:var(--mono);font-size:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center}
    :root[data-theme="dark"] .iq-n{color:#0A140F}
    @media (prefers-color-scheme:dark){.iq-n{color:#0A140F}}
    :root[data-theme="light"] .iq-n{color:var(--paper)}
    .iq-steps b{display:block;color:var(--ink);font-size:14px;font-weight:600}
    .iq-steps .t{display:block;color:var(--ink-soft);font-size:13.5px;line-height:1.5;max-width:54ch}
    .iq-steps .t strong{color:var(--ink);font-weight:600}
    .iq-cta{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-top:19px}
    .iq-alt{font-size:13px;color:var(--ink-soft);max-width:40ch}
    .iq-alt a{color:var(--brass);font-weight:600;text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--brass) 40%,transparent)}
    .iq-alt a:hover{color:var(--forest)}

    /* Explainer banner — a mock requirement list whose lines get matched and
       priced one after another. Illustrative only: it shows that a line came
       back priced, never a price, so nothing here can read as a real quote. */
    .iq-demo{margin:0;width:100%;max-width:460px;justify-self:end}
    @media (max-width:900px){.iq-demo{justify-self:stretch;max-width:none}}
    .iq-win{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
      box-shadow:var(--shadow);overflow:hidden}
    .iq-bar{display:flex;align-items:center;gap:7px;padding:10px 13px;border-bottom:1px solid var(--line-soft);
      background:color-mix(in srgb,var(--paper-2) 55%,var(--card))}
    .iq-bar i{width:8px;height:8px;border-radius:50%;background:var(--line)}
    .iq-bar span{margin-left:5px;font-family:var(--mono);font-size:11.5px;color:var(--muted)}
    .iq-rows{padding:2px 13px 8px}
    .iq-hd,.iq-row{display:grid;grid-template-columns:1fr 40px 86px;gap:9px;align-items:center}
    .iq-hd{padding:8px 0 6px;border-bottom:1px solid var(--line-soft);font-family:var(--mono);font-size:9.5px;
      letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .iq-row{padding:10px 0;border-bottom:1px solid var(--line-soft);font-size:13px}
    .iq-row:last-child{border-bottom:0}
    .iq-row .nm{color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .iq-row .qt,.iq-hd .qt{font-family:var(--mono);font-variant-numeric:tabular-nums;color:var(--ink-soft);text-align:right}
    .iq-hd .pr,.iq-row .pr{justify-self:end}
    .iq-row .pr{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;
      background:var(--ok-bg);color:var(--ok);font-family:var(--mono);font-size:11px;font-weight:600;white-space:nowrap;
      animation:iq-match .5s ease-out both;animation-delay:var(--d,0s)}
    .iq-row .pr svg{width:11px;height:11px;flex-shrink:0}
    .iq-foot{display:flex;align-items:center;gap:7px;padding:10px 13px;border-top:1px solid var(--line-soft);
      background:color-mix(in srgb,var(--forest) 7%,var(--card));font-family:var(--mono);font-size:11.5px;color:var(--ok)}
    .iq-foot svg{width:13px;height:13px;flex-shrink:0}
    .iq-cap{margin:10px 2px 0;font-size:12.5px;color:var(--muted);line-height:1.5}
    /* The lines land one after another — the stagger is what reads as
       "matching". It plays once and settles rather than looping: indefinite
       motion with no pause control would fail WCAG 2.2.2, and the settled
       state tells the same story. With reduced motion it starts settled. */
    @keyframes iq-match{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion:reduce){.iq-row .pr{animation:none;opacity:1;transform:none}}
    /* Real recording, when one is dropped in */
    .iq-video{width:100%;display:block;border-radius:var(--radius);border:1px solid var(--line);box-shadow:var(--shadow);background:var(--card)}

    /* Featured section */
    .feat{background:color-mix(in srgb,var(--forest) 6%,var(--paper));border-bottom:1px solid var(--line)}
    .feat-in{padding-top:26px;padding-bottom:30px}
    .feat-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px;margin:0 0 16px}
    .feat-eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);font-weight:bold}
    .feat-head h2{font-family:var(--serif);font-size:22px;font-weight:600;margin:0;color:var(--ink)}
    .feat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
    .feat .card{border-color:color-mix(in srgb,var(--brass-2) 40%,var(--line))}
    .feat-badge{align-self:flex-start;font-family:var(--mono);font-size:10px;font-weight:bold;letter-spacing:.08em;
      text-transform:uppercase;color:#fff;background:#B4231F;padding:3px 8px;border-radius:6px;margin-bottom:12px}
    .card.feat-on{border-color:color-mix(in srgb,var(--brass-2) 50%,var(--line))}

    .controls{position:sticky;top:60px;z-index:30;background:color-mix(in srgb,var(--paper) 90%,transparent);
      backdrop-filter:blur(8px);border-bottom:1px solid var(--line);padding:14px 0}
    .controls-in{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
    .search{position:relative;flex:1;min-width:220px;margin:0}
    .search input{width:100%;height:42px;border:1px solid var(--line);background:var(--card);color:var(--ink);
      border-radius:11px;padding:0 14px 0 40px;font-size:15px;font-family:var(--sans)}
    .search input:focus{outline:2px solid var(--brass-2);outline-offset:1px;border-color:transparent}
    .search svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted)}
    .chips{display:flex;flex-wrap:wrap;gap:7px}
    .chip{border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:999px;
      height:36px;padding:0 15px;font-size:13.5px;cursor:pointer;transition:.14s;white-space:nowrap}
    .chip:hover{border-color:var(--brass-2)}
    .chip[aria-pressed="true"]{background:var(--forest);color:var(--paper);border-color:var(--forest)}
    select.sort{height:36px;border:1px solid var(--line);background:var(--card);color:var(--ink-soft);
      border-radius:999px;padding:0 14px;font-size:13.5px;cursor:pointer;font-family:var(--sans)}

    main.wrap{padding:26px 20px 40px}
    .count{font-family:var(--mono);font-size:12.5px;color:var(--muted);margin:0 0 16px;letter-spacing:.03em}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;
      display:flex;flex-direction:column;gap:0;box-shadow:var(--shadow);transition:.16s;position:relative;overflow:hidden;
      /* Off-screen cards cost nothing to render — keeps the single-page catalogue
         fast on phones even if the base grows back past 1,000 offers. */
      content-visibility:auto;contain-intrinsic-size:auto 320px}
    .card[hidden]{display:none}  /* let search/filter actually hide cards (overrides display:flex) */
    .card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--brass-2) 55%,var(--line))}
    .card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--brass-2);opacity:0;transition:.16s}
    .card:hover::before{opacity:1}
    .c-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .brand{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--brass);margin-bottom:6px}
    .pname{font-family:var(--serif);font-size:19px;font-weight:600;line-height:1.15;margin:0;color:var(--ink);text-wrap:balance;
      display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    /* Variant lists live under the name so long assortments never blow up the card. */
    .variants{margin-top:5px;font-size:11.5px;line-height:1.35;color:var(--muted);font-family:var(--sans);
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .cat-tag{flex-shrink:0;font-size:10.5px;font-family:var(--mono);letter-spacing:.08em;text-transform:uppercase;
      color:var(--ink-soft);border:1px solid var(--line);border-radius:6px;padding:3px 7px;margin-top:2px}
    .spec{font-family:var(--mono);font-size:12.5px;color:var(--ink-soft);margin:12px 0 0;letter-spacing:.01em}
    .metaline{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
    .tag{font-size:11px;padding:3px 8px;border-radius:6px;font-family:var(--mono);letter-spacing:.03em;
      border:1px solid var(--line);color:var(--muted)}
    .tag.tier{border-color:color-mix(in srgb,var(--brass-2) 45%,var(--line));color:var(--brass)}
    .price-row{margin-top:16px;padding-top:14px;border-top:1px solid var(--line-soft);display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
    .price .amt{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1}
    .price .cur{font-size:12px;color:var(--muted);font-family:var(--mono)}
    .price .basis{font-size:12px;color:var(--muted);font-family:var(--mono);letter-spacing:.01em}
    .price .sub{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:5px;font-variant-numeric:tabular-nums}
    .pill{font-size:11px;font-weight:600;padding:4px 9px;border-radius:999px;white-space:nowrap;font-family:var(--sans)}
    .pill.ok{background:var(--ok-bg);color:var(--ok)}
    .pill.warn{background:var(--warn-bg);color:var(--warn)}
    .pill.neu{background:var(--neu-bg);color:var(--neu)}
    .stock{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
    .qty{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--ok);font-variant-numeric:tabular-nums;letter-spacing:.02em}
    .qty.muted{color:var(--muted);font-weight:400}
    .c-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:16px}
    .pname a{color:inherit;text-decoration:none}
    .pname a:hover{color:var(--brass);text-decoration:underline}
    .details{font-size:12.5px;font-weight:600;color:var(--brass);text-decoration:none;white-space:nowrap}
    .details:hover{text-decoration:underline}
    .catnav{border-top:1px solid var(--line);padding:36px 20px 30px;scroll-margin-top:76px}
    .catnav h2{font-family:var(--serif);font-size:24px;margin:0 0 8px;color:var(--ink)}
    .catnav-lede{color:var(--muted);margin:0 0 18px;font-size:14px}
    .catnav-list{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0}
    .catnav-list a{display:inline-flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);
      border-radius:999px;padding:8px 14px;font-size:14px;font-weight:600;color:var(--ink);text-decoration:none}
    .catnav-list a:hover{border-color:var(--brass);color:var(--brass)}
    .catnav-count{font-family:var(--mono);font-size:11.5px;font-weight:400;color:var(--muted)}
    .catnav-more{margin:20px 0 0;font-size:14px;color:var(--muted)}
    .catnav-more a{color:var(--brass);text-decoration:none}
    .catnav-more a:hover{text-decoration:underline}
    .incoterm{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
    .enquire{display:inline-flex;align-items:center;gap:7px;background:var(--forest);color:var(--paper);
      text-decoration:none;font-size:13px;font-weight:600;padding:8px 13px;border-radius:9px;transition:.14s;border:1px solid transparent}
    :root[data-theme="dark"] .enquire{color:#0A140F}
    @media (prefers-color-scheme:dark){.enquire{color:#0A140F}}
    .enquire:hover{background:var(--brass);color:#fff}
    .empty{text-align:center;padding:60px 20px;color:var(--muted);font-family:var(--mono);font-size:14px}

    footer{border-top:1px solid var(--line);padding:26px 0 44px;color:var(--muted);font-size:12.5px}
    footer .wrap{display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between}
    footer .note{max-width:64ch;line-height:1.6}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
    @media (max-width:560px){.hero-in{padding-top:26px;padding-bottom:20px}.ticker{gap:18px}}
  </style>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-wa" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5.2.6.8 2 .9 2.1.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1l1.8.9c.3.1.5.2.5.3.1.2.1.7-.1 1.4Z"/></symbol>
  </svg>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="mark" href="/" aria-label="AKAY home">
        <img class="logo-slot" src="/akay-bird.png" alt="" width="320" height="279" />AKAY<span class="dot"></span><b>trade</b>
      </a>
      <span class="bar-sub">akay.ie</span>
      <span class="bar-spacer"></span>
      <SiteSearch compact />
      <button class="theme-btn" id="themeBtn" aria-label="Toggle light or dark theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
        <span id="themeLbl">Theme</span>
      </button>
    </div>
  </header>

  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow">Wholesale beverage offers · duty-paid &amp; export</p>
      <h1>Live trade pricing, straight from the desk.</h1>
      <p class="lede">Spirits and beer by the case, with current pricing, pack specs and duty tier on every line. Filter, compare, and send a WhatsApp enquiry in one tap — no login, no PDF.</p>
      <div class="hero-cta">
        <a class="cta-quote" href="https://quote.akay.ie">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 15.5V3.5m0 0L7.8 7.7M12 3.5l4.2 4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 15.5V18a2.5 2.5 0 0 0 2.5 2.5h11A2.5 2.5 0 0 0 20 18v-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Upload Excel / Instant AI Quote Matcher
        </a>
        <span class="cta-note">Send us your buying list — every line matched to live stock and priced in seconds.</span>
      </div>
      <div class="ticker">
        {stats.map((s) => (
          <div class="stat"><div class="n">{s[0]}</div><div class="l">{s[1]}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="iq" id="instant-quote">
    <div class="wrap iq-in">
      <div class="iq-copy">
        <p class="iq-eyebrow"><span class="new">New</span> Instant Quote</p>
        <h2>Send your buying list. Get it back priced.</h2>
        <p class="iq-lede">No rep, no callback, no PDF round-trip. Upload the list you already work from and every line is matched against the live catalogue on this page and priced on the spot.</p>
        <ol class="iq-steps">
          <li>
            <span class="iq-n" aria-hidden="true">1</span>
            <div><b>Upload your list</b><span class="t">An Excel or CSV file with three columns — <strong>Brand</strong>, <strong>Product Name</strong>, <strong>Quantity</strong>.</span></div>
          </li>
          <li>
            <span class="iq-n" aria-hidden="true">2</span>
            <div><b>We match it to live stock</b><span class="t">Every line is read and matched against the {view.length.toLocaleString('en-IE')} offers live on this site right now — spelling, pack size and all.</span></div>
          </li>
          <li>
            <span class="iq-n" aria-hidden="true">3</span>
            <div><b>Your quote comes back priced</b><span class="t">Matched lines come back with trade price, pack spec and T1/T2 duty status. Anything we can't match is flagged so nothing goes quiet.</span></div>
          </li>
        </ol>
        <div class="iq-cta">
          <a class="cta-quote" href="https://quote.akay.ie">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 15.5V3.5m0 0L7.8 7.7M12 3.5l4.2 4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 15.5V18a2.5 2.5 0 0 0 2.5 2.5h11A2.5 2.5 0 0 0 20 18v-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Upload your list — get an instant quote
          </a>
          <span class="iq-alt">Rather use email? Send it to <a href="mailto:offers@akay.ie?subject=Requirement%20List">offers@akay.ie</a> with "Requirement List" in the subject — same three columns, same automatic pricing.</span>
        </div>
      </div>

      <figure class="iq-demo">
        {QUOTE_VIDEO ? (
          /* Play on tap, not on load: autoplay would spend a phone's data
             before anyone asked, and looping motion with no pause control
             fails WCAG 2.2.2. */
          <video class="iq-video" src={QUOTE_VIDEO} poster={QUOTE_VIDEO_POSTER} width="460" height="300"
                 controls muted playsinline preload="none"
                 aria-label="Screen recording: a requirement list uploaded to the Instant Quote tool and returned priced."></video>
        ) : (
          /* aria-hidden: it's a picture of the three steps spelled out above,
             so a screen reader gets the caption instead of a mock table. */
          <div class="iq-win" aria-hidden="true">
            <div class="iq-bar"><i></i><i></i><i></i><span>requirement-list.xlsx</span></div>
            <div class="iq-rows">
              <div class="iq-hd"><span>Product</span><span class="qt">Qty</span><span class="pr">Status</span></div>
              <div class="iq-row" style="--d:.1s"><span class="nm">Irish whiskey · 12 × 70cl</span><span class="qt">40</span><span class="pr"><svg viewBox="0 0 24 24" fill="none"><path d="m5 13 4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Priced</span></div>
              <div class="iq-row" style="--d:.55s"><span class="nm">Lager · 24 × 330ml can</span><span class="qt">25</span><span class="pr"><svg viewBox="0 0 24 24" fill="none"><path d="m5 13 4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Priced</span></div>
              <div class="iq-row" style="--d:1s"><span class="nm">Vodka · 6 × 1L</span><span class="qt">60</span><span class="pr"><svg viewBox="0 0 24 24" fill="none"><path d="m5 13 4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Priced</span></div>
            </div>
            <div class="iq-foot">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="m8 12 2.8 2.8L16 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              3 of 3 lines matched · quote ready
            </div>
          </div>
        )}
        <figcaption class="iq-cap">How it works: your spreadsheet goes in, each line is matched against live stock, and the priced quote comes back — usually in seconds.</figcaption>
      </figure>
    </div>
  </section>

  <section class="controls">
    <div class="wrap controls-in">
      <form class="search" action="/search/" method="get" role="search" title="Type to filter this page; press Enter for full search with size, pack and bond filters">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="q" name="q" type="search" placeholder="Filter brand or product — press Enter for full search" autocomplete="off" />
      </form>
      <div class="chips" id="cats">
        {categories.map((c) => (
          <button class="chip" data-cat={c} aria-pressed={c === 'All' ? 'true' : 'false'}>{c}</button>
        ))}
      </div>
      <select class="sort" id="sort" aria-label="Sort offers">
        <option value="rel">Sort: Featured</option>
        <option value="asc">Price ↑ (low→high)</option>
        <option value="desc">Price ↓ (high→low)</option>
        <option value="az">Name A→Z</option>
      </select>
    </div>
  </section>

  <main class="wrap">
    <p class="count" id="count">Showing {view.length} of {view.length} offers</p>
    <div class="grid" id="grid">
      {gridItems.map((o) => (
        <article class={`card${o.featured ? ' feat-on' : ''}`} data-cat={o.category} data-name={(o.name + ' ' + (o.variants || '') + ' ' + o.brand).toLowerCase()} data-amt={o.unitAmount ?? o.amount ?? ''} data-feat={o.featured ? '1' : '0'}>
          {o.featured && <span class="feat-badge">★ Featured</span>}
          <div class="c-top">
            <div>
              <div class="brand">{o.brand}</div>
              <h3 class="pname"><a href={`/offers/${o.slug}/`} title={o.name}>{o.name}</a></h3>
              {o.variants && <div class="variants" title={o.variants}>{o.variants}</div>}
            </div>
            <span class="cat-tag">{o.category}</span>
          </div>
          <div class="spec">{o.spec}</div>
          <div class="metaline">
            {o.tier && <span class="tag tier">{o.tier}</span>}
            {o.origin && <span class="tag">{o.origin}</span>}
            {o.currency && <span class="tag">{o.currency}</span>}
          </div>
          <div class="price-row">
            <div class="price">
              <div><span class="cur">{o.currency}</span> <span class="amt">{o.amount != null ? o.amount.toFixed(2) : '—'}</span> <span class="basis">{o.basis}</span></div>
              {o.other && <div class="sub">{o.other}</div>}
            </div>
            <div class="stock">
              <span class={`pill ${o.st[0]}`}>{o.st[1]}</span>
              {o.qty ? <span class="qty" title="Cases available">{o.qty.toLocaleString()} cases</span> : <span class="qty muted">on request</span>}
            </div>
          </div>
          <div class="c-foot">
            <a class="details" href={`/offers/${o.slug}/`}>Details</a>
            <span class="incoterm">{o.terms}</span>
            <a class="enquire" href={o.wa} target="_blank" rel="noopener"
               data-offer={o.name} data-brand={o.brand} data-category={o.category}
               data-currency={o.currency} data-amount={o.amount}>
              <svg width="14" height="14" aria-hidden="true"><use href="#i-wa" /></svg>
              Enquire
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="empty" id="empty" hidden>No offers match that filter. Try clearing the search.</div>
  </main>

  <section id="categories" class="catnav">
    <div class="wrap">
      <h2>Browse by category</h2>
      <p class="catnav-lede">Every category has its own page with the full live list, trade pricing and duty status.</p>
      <nav aria-label="Offer categories">
        <ul class="catnav-list">
          {categoryLinks.map((c) => (
            <li><a href={c.href}>{c.name}<span class="catnav-count">{c.count}</span></a></li>
          ))}
        </ul>
      </nav>
      <p class="catnav-more">
        New to trade buying? Read <a href="/guides/t1-vs-t2-duty-status/">T1 vs T2 duty status</a>,
        <a href="/guides/incoterms-exw-dap-cfr/">Incoterms explained</a> and
        <a href="/guides/how-to-buy-wholesale-spirits-eu/">how to buy wholesale in the EU</a>,
        or read more <a href="/about/">about AKAY Trade</a>.
      </p>
    </div>
  </section>

  <section id="guides" style="border-top:1px solid var(--line);padding:40px 20px;background:var(--paper-2);scroll-margin-top:76px">
    <div class="wrap">
      <h2 style="font-family:var(--serif);font-size:24px;margin:0 0 12px;color:var(--ink)"><a href="/guides/" style="color:inherit;text-decoration:none">Buyer's guides</a></h2>
      <p style="color:var(--muted);margin:0 0 26px;font-size:14px">Guides for wholesale buyers: duty status, shipping terms, how to order. <a href="/guides/" style="color:var(--brass);text-decoration:none">See all guides →</a></p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
        {guides.map((guide) => (
          <a href={`/guides/${guide.slug}/`} style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;text-decoration:none;transition:.16s;display:flex;flex-direction:column">
            <h3 style="margin:0 0 8px;font-size:16px;font-family:var(--serif);font-weight:600;color:var(--ink);line-height:1.3">{guide.title}</h3>
            <p style="margin:0;color:var(--muted);font-size:14px;flex-grow:1">{guide.excerpt}</p>
            <span style="color:var(--brass);font-size:13px;font-weight:600;margin-top:12px">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="note">
        Live catalogue from AKAY's Airtable. Prices are indicative and shown per the listing basis; supplier identity, buy prices and margins are never published. <strong>T1</strong> = export / under-bond · <strong>T2</strong> = for sale in the EU.
        <br /><br />
        <a href="/about/" style="color:var(--brass);text-decoration:none">About AKAY</a> · <a href="/guides/" style="color:var(--brass);text-decoration:none">Guides</a> · <a href="/guides/requirement-list-format/" style="color:var(--brass);text-decoration:none">How to order</a>
      </div>
      <div style="font-family:var(--mono);text-align:right">© AKAY · Shannon<br /><a href={WA_LINK} style="color:var(--brass);text-decoration:none">WhatsApp</a> · <a href="mailto:hello@akay.ie" style="color:var(--brass);text-decoration:none">hello@akay.ie</a></div>
    </div>
  </footer>

  <script>
    const grid = document.getElementById('grid');
    const cards = Array.from(grid.children);

    // GA4: record which offers drive WhatsApp enquiries. Delegated so it also
    // covers cards re-ordered by the filter/sort logic below.
    grid.addEventListener('click', (e) => {
      const a = e.target.closest('a.enquire');
      if (!a || typeof window.gtag !== 'function') return;
      const amt = parseFloat(a.dataset.amount);
      window.gtag('event', 'whatsapp_enquiry', {
        offer_name: a.dataset.offer,
        brand: a.dataset.brand,
        category: a.dataset.category,
        currency: a.dataset.currency || undefined,
        value: Number.isFinite(amt) ? amt : undefined,
      });
    });
    const q = document.getElementById('q');
    const cats = document.getElementById('cats');
    const sortSel = document.getElementById('sort');
    const countEl = document.getElementById('count');
    const emptyEl = document.getElementById('empty');
    const total = cards.length;
    let state = { q: '', cat: 'All', sort: 'rel' };
    const order = cards.map((c, i) => [c, i]); // preserve original "featured" order

    // Fast path: search + category just toggle visibility (no DOM reordering).
    function filter() {
      let shown = 0;
      for (const c of cards) {
        const okCat = state.cat === 'All' || c.dataset.cat === state.cat;
        const okQ = !state.q || c.dataset.name.includes(state.q);
        const vis = okCat && okQ;
        c.hidden = !vis;
        if (vis) shown++;
      }
      countEl.textContent = `Showing ${shown} of ${total} offers` + (state.cat !== 'All' ? ` · ${state.cat}` : '');
      emptyEl.hidden = shown > 0;
    }

    // Reordering only runs when the sort changes — batched via a fragment so 1,191 cards stay snappy.
    function sortCards() {
      const arr = order.slice();
      // data-amt is a per-unit figure for every offer, so price sorting compares
      // like with like. Offers priced "on request" have no number — they always
      // sink to the bottom instead of masquerading as the cheapest.
      const priceOf = (el) => { const v = parseFloat(el.dataset.amt); return Number.isFinite(v) ? v : null; };
      if (state.sort === 'asc' || state.sort === 'desc') {
        const dir = state.sort === 'asc' ? 1 : -1;
        arr.sort((a, b) => {
          const pa = priceOf(a[0]), pb = priceOf(b[0]);
          if (pa === null && pb === null) return a[1] - b[1];
          if (pa === null) return 1;
          if (pb === null) return -1;
          return (pa - pb) * dir;
        });
      }
      else if (state.sort === 'az') arr.sort((a, b) => a[0].querySelector('.pname').textContent.localeCompare(b[0].querySelector('.pname').textContent));
      else arr.sort((a, b) => a[1] - b[1]);
      const frag = document.createDocumentFragment();
      for (const [c] of arr) frag.appendChild(c);
      grid.appendChild(frag);
    }

    q.addEventListener('input', (e) => { state.q = e.target.value.toLowerCase().trim(); filter(); });
    sortSel.addEventListener('change', (e) => { state.sort = e.target.value; sortCards(); filter(); });
    cats.addEventListener('click', (e) => {
      const b = e.target.closest('.chip');
      if (!b) return;
      state.cat = b.dataset.cat;
      Array.from(cats.children).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      filter();
    });

    // Deep link: akay.ie/#spirits (or #beer, #grocery …) preselects that
    // category chip. Used by the email-signature link bar and shareable links;
    // an unknown hash is ignored. Matched case-insensitively against the chips.
    const hashCat = decodeURIComponent(location.hash.slice(1)).trim().toLowerCase();
    if (hashCat) {
      const chip = Array.from(cats.children).find((x) => (x.dataset.cat || '').toLowerCase() === hashCat);
      if (chip) chip.click();
    }

    // The category-request form that posted to the n8n category-request webhook
    // was retired with the "offers straight to your inbox" block; the Instant
    // Quote section that replaced it is static markup and needs no script.

    const root = document.documentElement;
    document.getElementById('themeBtn').addEventListener('click', () => {
      const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      document.getElementById('themeLbl').textContent = next === 'dark' ? 'Light' : 'Dark';
    });
  </script>
</body>
</html>
