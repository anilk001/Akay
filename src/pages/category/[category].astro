---
import SiteHeader from '../../components/SiteHeader.astro';
import { getOffers } from '../../data/airtable.mjs';
import { withSlugs } from '../../lib/slug.mjs';
import { categoryItemListSchema, organizationSchema, crumbs } from '../../lib/schema.mjs';
import Seo from '../../components/Seo.astro';
import { priceLabel } from '../../lib/price.mjs';

export async function getStaticPaths() {
  const { offers } = await getOffers();
  const offersWithSlugs = withSlugs(offers);
  const categories = Array.from(new Set(offersWithSlugs.map((o) => o.category))).sort();

  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category, offers: offersWithSlugs },
  }));
}

const { category, offers } = Astro.props;

// Get offers in this category
const categoryOffers = offers
  .filter((o) => o.category === category)
  .sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

// Build schemas
const orgSchema = organizationSchema();
const itemListSchema = categoryItemListSchema(category, categoryOffers);

const categorySlug = category.toLowerCase().replace(/\s+/g, '-');

// Distinct facts per category page — brand count, stock count and the duty
// tiers actually present — so the ~10 category pages don't read as one
// boilerplate template repeated ten times.
const brandNames = Array.from(new Set(categoryOffers.map((o) => o.brand).filter(Boolean))).sort();
const inStockCount = categoryOffers.filter((o) => o.stock === 'in').length;
const tiers = Array.from(new Set(categoryOffers.map((o) => o.tier).filter(Boolean))).sort();

// "T1, T2 and Bonded" rather than "T1 and T2 and Bonded and …".
function listPhrase(items, max = 3) {
  const shown = items.slice(0, max);
  if (shown.length === 0) return '';
  if (shown.length === 1) return shown[0];
  return `${shown.slice(0, -1).join(', ')} and ${shown[shown.length - 1]}`;
}

const pageTitle = `Wholesale ${category} — ${categoryOffers.length} Live Trade Offers | AKAY Trade`;
const pageDesc = [
  `${categoryOffers.length} wholesale ${category.toLowerCase()} offers from AKAY Trade, Ireland`,
  brandNames.length ? `${brandNames.length} brands including ${listPhrase(brandNames, 4)}` : null,
  tiers.length ? `${listPhrase(tiers)} duty status` : null,
  'by the case and pallet, with live trade prices and pack specs.',
].filter(Boolean).join(' · ').slice(0, 300);

// Sibling categories keep every category page one click from the others, so
// crawlers reach the whole catalogue without depending on the homepage.
const siblingCategories = Array.from(new Set(offers.map((o) => o.category)))
  .filter((c) => c && c !== category)
  .sort()
  .map((c) => ({ name: c, slug: c.toLowerCase().replace(/\s+/g, '-') }));

// Built as one string: adjacent JSX expressions swallow the whitespace
// between them, which silently produced "491brands" in the rendered copy.
const introLine = [
  `${categoryOffers.length} live ${category.toLowerCase()} ${categoryOffers.length === 1 ? 'line' : 'lines'} from AKAY Trade`,
  brandNames.length ? `across ${brandNames.length} ${brandNames.length === 1 ? 'brand' : 'brands'}` : null,
  'priced by the case and pallet for trade buyers.',
].filter(Boolean).join(', ') + (inStockCount > 0
  ? ` ${inStockCount} ${inStockCount === 1 ? 'line is' : 'lines are'} in stock now; the rest are priced on enquiry.`
  : '');

const breadcrumbData = crumbs([
  { name: 'Home', path: '/' },
  { name: category, path: `/category/${categorySlug}/` },
]);
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle={`Wholesale ${category} Offers`}
    path={`/category/${categorySlug}/`}
    schemas={[orgSchema, itemListSchema, breadcrumbData]}
  />

  <style>
    :root {
      --paper: #F7F5F0;
      --paper-2: #EFEDE4;
      --card: #FFFFFF;
      --ink: #17140F;
      --ink-soft: #41473F;
      --muted: #767E72;
      --line: #E4E0D4;
      --brass: #B4231F;
      --ok: #0E7A3B;
      --ok-bg: #E2F0E5;
      --warn: #9A6A12;
      --warn-bg: #F5E9CE;
      --neu: #5C6A78;
      --neu-bg: #E9ECEF;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F;
        --paper-2: #081009;
        --card: #13201A;
        --ink: #F1EFE7;
        --ink-soft: #C6CEC4;
        --muted: #8A968A;
        --line: #243029;
        --brass: #EC5A52;
        --ok: #5FC97E;
        --ok-bg: #123021;
        --warn: #E0B65C;
        --warn-bg: #31280F;
        --neu: #9AA7B4;
        --neu-bg: #1B2530;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    h2 {
      font: 600 1.3em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 20px;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }
    .breadcrumb a {
      color: var(--brass);
    }

    .header {
      margin-bottom: 2em;
    }

    .header p {
      color: var(--muted);
      font-size: 1em;
      margin: 0.5em 0 0;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5em;
      margin: 2em 0;
    }

    .offer-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .offer-card h3 {
      margin: 0 0 0.5em;
      font: 600 1.1em var(--serif);
      color: var(--ink);
    }

    .offer-card p {
      margin: 0.3em 0;
      color: var(--muted);
      font-size: 0.9em;
    }

    .offer-card .price {
      font: 600 1.3em var(--serif);
      color: var(--brass);
      margin: 0.8em 0 0.5em;
    }

    .offer-card .stock {
      font-size: 0.85em;
      font-weight: 600;
      padding: 0.3em 0.6em;
      border-radius: 4px;
      display: inline-block;
      margin: 0.5em 0;
    }

    .stock-ok {
      background: var(--ok-bg);
      color: var(--ok);
    }
    .stock-warn {
      background: var(--warn-bg);
      color: var(--warn);
    }
    .stock-neu {
      background: var(--neu-bg);
      color: var(--neu);
    }

    .offer-card a.view-link {
      font-weight: 600;
      margin-top: auto;
      padding-top: 1em;
      border-top: 1px solid var(--line);
    }

    .nav {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      margin-top: 3em;
    }

    .nav a {
      margin: 0 1em;
      color: var(--brass);
    }

    .sibling-cats {
      border-top: 1px solid var(--line);
      padding: 1.5em 0 3em;
    }

    .sibling-cats h2 {
      font-size: 1rem;
      margin: 0 0 0.8em;
      color: var(--muted, #767E72);
    }

    .sibling-cats ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6em;
      margin: 0;
      padding: 0;
    }

    .sibling-cats a {
      display: inline-block;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.4em 0.9em;
      font-size: 0.9rem;
      color: var(--brass);
      text-decoration: none;
    }

    .sibling-cats a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <SiteHeader section={category} width={1000} />
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / {category}
    </div>

    <div class="header">
      <h1>Wholesale {category} Offers</h1>
      <p>{introLine}</p>
      <p>
        Prices are indicative and move with the market. Upload your buying list in
        any format at <a href="https://quote.akay.ie">quote.akay.ie</a> and get it
        back priced on the spot — see
        <a href="/guides/requirement-list-format/">how to send a requirement list</a>.
        {tiers.length > 0 && <> Duty status on this page: {listPhrase(tiers, 5)} — see <a href="/guides/t1-vs-t2-duty-status/">T1 vs T2 explained</a>.</>}
      </p>
    </div>

    <div class="offer-grid">
      {categoryOffers.map((offer) => {
        const stockStatus = offer.stock === 'in' ? 'ok'
          : offer.stock === 'warn' ? 'warn'
          : 'neu';
        const stockText = offer.stock === 'in' ? 'In stock'
          : offer.stock === 'warn' ? 'Limited'
          : 'Enquire';

        return (
          <div class="offer-card">
            <h3>{offer.name}</h3>
            {offer.spec && <p>{offer.spec}</p>}
            <div class="price">{priceLabel(offer, { short: true })}</div>
            <span class={`stock stock-${stockStatus}`}>{stockText}</span>
            {offer.tier && <p><strong>Duty:</strong> {offer.tier}</p>}
            <a href={`/offers/${offer.canonicalSlug || offer.slug}/`} class="view-link">View offer →</a>
          </div>
        );
      })}
    </div>

    <div class="nav">
      <a href="/">← Back to catalogue</a>
      |
      <a href="/#categories">Browse all categories</a>
      |
      <a href="/about/">About AKAY</a>
    </div>

    <nav class="sibling-cats" aria-label="Other categories">
      <h2>Other categories</h2>
      <ul>
        {siblingCategories.map((c) => (
          <li><a href={`/category/${c.slug}/`}>Wholesale {c.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</body>
</html>
