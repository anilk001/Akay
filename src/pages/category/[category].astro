---
// §1 — one page per category (9 of them).
//
// Rewritten to use the shared card and shell. It previously carried a second,
// simpler card design of its own that printed every price as "/ case" —
// wrong on the ~250 lines priced per bottle, where it understated the case
// price by the pack size. Using the real card fixes that by construction.
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfferCard from '../../components/OfferCard.astro';
import RfqBasket from '../../components/RfqBasket.astro';
import { getCatalogue, featuredFirst } from '../../lib/catalogue.mjs';
import { categoryIntro, aggregationFacts } from '../../lib/aggregation-intro.mjs';
import { organizationSchema, aggregationItemListSchema, breadcrumbList } from '../../lib/schema.mjs';
import { brandSlug } from '../../lib/slug.mjs';

export async function getStaticPaths() {
  const { categories } = await getCatalogue();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const offers = featuredFirst(category.offers);
const path = `/category/${category.slug}/`;

const intro = categoryIntro(category.name, offers);
const facts = aggregationFacts(offers);

// Top brands by line count — the fastest route from a category page to a
// specific brand page, and the internal linking that gets those 691 pages
// crawled in the first place.
const brandCounts = new Map();
for (const o of offers) {
  if (o.brand) brandCounts.set(o.brand, (brandCounts.get(o.brand) || 0) + 1);
}
const topBrands = [...brandCounts.entries()]
  .map(([name, count]) => ({ name, slug: brandSlug(name), count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const title = `Wholesale ${category.name} — Export Case Prices | Akay Irl Ltd`;
const description = `${facts.lines} live wholesale ${category.name.toLowerCase()} lines across ${facts.brands.length} brands — trade pricing by the case, pack specs, customs status and loading terms on every line.`;

const jsonLd = [
  organizationSchema(),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Categories', path: '/categories/' },
    { name: category.name, path },
  ]),
  aggregationItemListSchema({ name: `Wholesale ${category.name} offers`, path, offers }),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} i18nPath={path} wide={true}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Catalogue</a>
    <span aria-hidden="true">/</span>
    <a href="/categories/">Categories</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{category.name}</span>
  </nav>

  <header class="agg-head">
    <p class="eyebrow">Category</p>
    <h1>{category.name} wholesale offers</h1>
    {intro.map((p) => <p class="agg-intro">{p}</p>)}

    <dl class="agg-stats">
      <div><dt>Live lines</dt><dd>{facts.lines}</dd></div>
      <div><dt>Brands</dt><dd>{facts.brands.length}</dd></div>
      {facts.inStock > 0 && <div><dt>In stock now</dt><dd>{facts.inStock}</dd></div>}
      {facts.currencies.length > 0 && <div><dt>Currencies</dt><dd>{facts.currencies.join(' / ')}</dd></div>}
    </dl>

    <div class="agg-actions">
      <RfqBasket />
    </div>
  </header>

  {topBrands.length > 1 && (
    <nav class="brand-strip" aria-label={`Brands in ${category.name}`}>
      <h2>Brands in {category.name}</h2>
      <div class="brand-chips">
        {topBrands.slice(0, 40).map((b) => (
          <a href={`/brand/${b.slug}/`}>{b.name}<span>{b.count}</span></a>
        ))}
      </div>
      {topBrands.length > 40 && <p class="brand-more"><a href="/brands/">See all {topBrands.length} brands in this category →</a></p>}
    </nav>
  )}

  <div class="grid">
    {offers.map((offer) => <OfferCard offer={offer} context="category" />)}
  </div>

  <nav class="agg-links" aria-label="Related">
    <div class="agg-links-row">
      <span class="agg-links-label">More:</span>
      <a href="/categories/">All categories</a>
      <a href="/brands/">All brands</a>
      <a href="/trade-terms/">Trade terms and Incoterms</a>
      <a href="/customs-glossary/">T1, T2 and bonded explained</a>
    </div>
  </nav>
</BaseLayout>

<style>
  .crumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:12.5px;color:var(--muted);margin-bottom:18px;font-family:var(--mono)}
  .crumbs a{color:var(--brass);text-decoration:none}
  .crumbs a:hover{text-decoration:underline}

  .agg-head{margin-bottom:24px;padding-bottom:22px;border-bottom:1px solid var(--line)}
  .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;
    color:var(--brass);margin:0 0 10px}
  h1{font-family:var(--serif);font-weight:600;font-size:clamp(26px,4vw,38px);line-height:1.08;
    margin:0 0 14px;letter-spacing:-.01em;text-wrap:balance}
  .agg-intro{margin:0 0 9px;color:var(--ink-soft);font-size:15px;max-width:74ch}
  .agg-stats{display:flex;flex-wrap:wrap;gap:14px 30px;margin:20px 0 0;padding-top:16px;border-top:1px solid var(--line-soft)}
  .agg-stats dt{font-size:11.5px;color:var(--muted);letter-spacing:.03em}
  .agg-stats dd{margin:2px 0 0;font-family:var(--mono);font-size:17px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums}
  .agg-actions{margin-top:20px}

  .brand-strip{margin-bottom:26px}
  .brand-strip h2{font-family:var(--serif);font-size:16px;font-weight:600;margin:0 0 10px;color:var(--ink)}
  .brand-chips{display:flex;flex-wrap:wrap;gap:7px}
  .brand-chips a{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--card);
    color:var(--ink-soft);border-radius:999px;padding:5px 12px;font-size:13px;text-decoration:none;transition:.14s}
  .brand-chips a:hover{border-color:var(--brass-2);color:var(--brass)}
  .brand-chips a span{font-family:var(--mono);font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
  .brand-more{margin:10px 0 0;font-size:13px}
  .brand-more a{color:var(--brass);text-decoration:none}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}

  .agg-links{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);font-size:13.5px}
  .agg-links-row{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline}
  .agg-links-label{color:var(--muted);font-size:12.5px}
  .agg-links a{color:var(--brass);text-decoration:none}
  .agg-links a:hover{text-decoration:underline}
</style>
