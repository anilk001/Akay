---
import SiteSearch from '../../components/SiteSearch.astro';
import { getOffers } from '../../data/airtable.mjs';
import { withSlugs, brandPages } from '../../lib/slug.mjs';
import { productOfferSchema, breadcrumbSchema, organizationSchema } from '../../lib/schema.mjs';
import Seo from '../../components/Seo.astro';
import { priceLabel } from '../../lib/price.mjs';
import { enquiryLink, WA_LINK, WA_DISPLAY } from '../../lib/whatsapp.mjs';

// Get all valid slugs for static generation. Sold-out (delisted) offers keep
// their pages — live offers are slugged FIRST so a re-listed line always owns
// the canonical slug and its sold-out twin takes the -2 suffix, never the
// other way round. The sitemap slugs the same combined list in the same order.
export async function getStaticPaths() {
  const { offers, delisted } = await getOffers();
  const all = withSlugs([...offers, ...delisted]);
  const liveOffers = all.filter((o) => !o.delisted);
  // Brand page URL per brand name, for the breadcrumb link (only brands that
  // actually get a landing page — brand pages list live stock only).
  const brandSlugByName = new Map(brandPages(liveOffers).map((p) => [p.brand, p.slug]));

  return all.map((offer) => ({
    params: { slug: offer.slug },
    // allOffers is live-only: related offers must always point at buyable stock.
    props: { offer, allOffers: liveOffers, brandSlug: brandSlugByName.get((offer.brand || '').trim()) || null },
  }));
}

const { offer, allOffers, brandSlug } = Astro.props;
const slug = offer.slug;

// Airtable lists the same product more than once (different lot or supplier).
// Those pages all point their canonical at one representative URL so search
// engines index a single page per product — see withSlugs() in lib/slug.mjs.
const canonicalPath = `/offers/${offer.canonicalSlug || slug}/`;

// Helper functions
function priceParts(detail = '') {
  const parts = detail.split('·').map((s) => s.trim());
  const first = parts[0] || '';
  const basis = /\/\s*bottle/i.test(first) ? '/ btl'
    : /\/\s*case/i.test(first) ? '/ case'
    : /\/\s*unit/i.test(first) ? '/ unit' : '';
  const msg = basis === '/ btl' ? 'per bottle' : basis === '/ case' ? 'per case' : basis === '/ unit' ? 'per unit' : '';
  const other = parts.slice(1).join(' · ');
  return { basis, other, msg };
}

const STOCK = { in: ['ok', 'In stock'], warn: ['warn', 'Limited'], enq: ['neu', 'Enquire'] };

const isDelisted = !!offer.delisted;

const { basis, other, msg } = priceParts(offer.priceDetail);
const st = isDelisted ? ['neu', 'Out of stock'] : (STOCK[offer.stock] || STOCK.enq);
const wa = enquiryLink(offer, msg, { soldOut: isDelisted });

// Category slug for linking
const categorySlug = offer.category.toLowerCase().replace(/\s+/g, '-');

// Related offers (same category, max 4, live stock only). Deterministic:
// each offer takes a different window of its category, rotated by its own
// position, so internal links vary across pages but the HTML is stable from
// build to build (random picks churned every page on every rebuild, wasting
// crawl budget on no-op content changes). A delisted offer isn't in the live
// list (findIndex -1), so it rotates by a hash of its own slug instead.
const sameCategory = allOffers.filter((o) => o.category === offer.category);
const otherOffers = sameCategory.filter((o) => o.slug !== offer.slug);
const foundIndex = sameCategory.findIndex((o) => o.slug === offer.slug);
const selfIndex = foundIndex >= 0
  ? foundIndex
  : [...offer.slug].reduce((sum, c) => sum + c.charCodeAt(0), 0) % Math.max(1, otherOffers.length);
const relatedOffers = Array.from(
  { length: Math.min(4, otherOffers.length) },
  (_, k) => otherOffers[(selfIndex + k) % otherOffers.length]
);

// Build schemas
const orgSchema = organizationSchema();
const productSchema = productOfferSchema(offer, offer.canonicalSlug || slug);
const breadcrumbData = breadcrumbSchema(offer.name, offer.category, offer.canonicalSlug || slug);

// Short availability phrase for the meta description (the on-page version
// with case counts is built further down). A delisted offer's stock fields
// are frozen at the moment it sold, so they are never echoed.
const stockLine = isDelisted ? 'sold out — request a quote'
  : offer.stock === 'in'
  ? (offer.qty ? `${offer.qty.toLocaleString()} cases in stock` : 'in stock')
  : offer.stock === 'warn' ? 'limited availability' : 'enquire for availability';

// Title and meta. priceLabel() reads the parsed basis, so a per-bottle line
// never gets a "/case" price in its SERP snippet. Sold-out pages trade the
// price for the out-of-stock state — quoting a dead price in a SERP snippet
// invites clicks the page can't honour.
const price = priceLabel(offer);

// Product names run to 200+ characters on multi-variant lines. Budget the
// title so the whole string stays near 110 characters — the product name is
// the part that gets shortened, since the pack size and price are what make
// one line distinguishable from the next.
const titleTail = isDelisted
  ? `${offer.spec ? ` ${offer.spec}` : ''} wholesale — out of stock, request a quote | AKAY Trade`
  : `${offer.spec ? ` ${offer.spec}` : ''} wholesale — ${price} | AKAY Trade`;
const nameBudget = Math.max(24, 110 - titleTail.length);
const shortName = offer.name.length > nameBudget
  ? `${offer.name.slice(0, nameBudget - 1).trimEnd().replace(/[\s,;·—-]+$/, '')}…`
  : offer.name;

const pageTitle = `${shortName}${titleTail}`;
const pageDesc = isDelisted
  ? `${offer.name}${offer.spec ? ` (${offer.spec})` : ''} wholesale is currently sold out at AKAY Trade. Request a quote for this or a similar line via WhatsApp — stock turns over daily.`
  : [
      `Buy ${offer.name}${offer.spec ? ` (${offer.spec})` : ''} wholesale from AKAY Trade`,
      price,
      offer.tier,
      offer.terms,
      offer.origin ? `origin ${offer.origin}` : null,
      stockLine,
    ].filter(Boolean).join(' · ').slice(0, 300);

// On-page stock detail (never echoed for a delisted offer).
let stockDetail = '';
if (!isDelisted && offer.stock === 'in' && offer.qty) {
  stockDetail = `${offer.qty.toLocaleString()} cases available`;
}
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle={shortName}
    path={canonicalPath}
    type="product"
    schemas={[orgSchema, productSchema, breadcrumbData]}
  />

  <style>
    :root {
      --paper: #F7F5F0;
      --paper-2: #EFEDE4;
      --card: #FFFFFF;
      --ink: #17140F;
      --ink-soft: #41473F;
      --muted: #767E72;
      --line: #E4E0D4;
      --brass: #B4231F;
      --ok: #0E7A3B;
      --ok-bg: #E2F0E5;
      --warn: #9A6A12;
      --warn-bg: #F5E9CE;
      --neu: #5C6A78;
      --neu-bg: #E9ECEF;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F;
        --paper-2: #081009;
        --card: #13201A;
        --ink: #F1EFE7;
        --ink-soft: #C6CEC4;
        --muted: #8A968A;
        --line: #243029;
        --brass: #EC5A52;
        --ok: #5FC97E;
        --ok-bg: #123021;
        --warn: #E0B65C;
        --warn-bg: #31280F;
        --neu: #9AA7B4;
        --neu-bg: #1B2530;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    body {
      margin: 0;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    h2 {
      font: 600 1.3em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }
    .breadcrumb a {
      color: var(--brass);
    }

    .offer-header {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 2em;
      margin-bottom: 2em;
      box-shadow: var(--shadow);
    }

    .price-display {
      font: 600 1.8em var(--serif);
      color: var(--brass);
      margin: 0.5em 0;
    }

    .soldout-banner {
      background: var(--warn-bg);
      color: var(--warn);
      border: 1px solid var(--warn);
      border-radius: 8px;
      padding: 0.8em 1em;
      margin: 1em 0 0.5em;
      font-size: 0.95em;
    }

    .stock-badge {
      display: inline-block;
      padding: 0.4em 0.8em;
      border-radius: 6px;
      font-size: 0.9em;
      font-weight: 600;
      margin: 0.5em 0;
    }

    .stock-ok {
      background: var(--ok-bg);
      color: var(--ok);
    }
    .stock-warn {
      background: var(--warn-bg);
      color: var(--warn);
    }
    .stock-neu {
      background: var(--neu-bg);
      color: var(--neu);
    }

    .spec-row {
      display: flex;
      justify-content: space-between;
      padding: 0.8em 0;
      border-bottom: 1px solid var(--line);
    }
    .spec-row:last-child {
      border-bottom: none;
    }

    .spec-label {
      color: var(--muted);
      font-weight: 600;
    }
    .spec-value {
      text-align: right;
      color: var(--ink);
    }
    /* "estimated" marks a minimum taken from the supplier's usual terms rather
       than stated for this line. Deliberately quiet — it is a caveat on the
       number beside it, not a feature to advertise. */
    .spec-hedge {
      display: inline-block;
      margin-left: 0.5em;
      font-family: var(--mono, monospace);
      font-size: 0.72em;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid var(--line);
      border-radius: 3px;
      padding: 0.1em 0.4em;
      vertical-align: middle;
      cursor: help;
    }

    .cta-button {
      display: inline-block;
      background: var(--brass);
      color: white;
      padding: 0.8em 1.6em;
      border-radius: 6px;
      font-weight: 600;
      margin: 1em 0.5em 1em 0;
      border: none;
      cursor: pointer;
    }
    .cta-button:hover {
      background: var(--brass);
      text-decoration: none;
      opacity: 0.9;
    }

    .cta-secondary {
      background: var(--paper-2);
      color: var(--ink);
      border: 1px solid var(--line);
    }

    .related-offers {
      margin: 3em 0 0;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5em;
      margin-top: 1em;
    }

    .offer-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      box-shadow: var(--shadow);
    }

    .offer-card h3 {
      margin: 0 0 0.5em;
      font: 600 1.1em var(--serif);
      color: var(--ink);
    }

    .offer-card .price {
      font: 600 1.3em var(--serif);
      color: var(--brass);
      margin: 0.5em 0;
    }

    .footer {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.9em;
      margin-top: 3em;
    }

    .footer a {
      color: var(--brass);
    }
  </style>
</head>
<body>
  <div class="container">
    <SiteSearch />
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${categorySlug}/`}>{offer.category}</a>
      {brandSlug && <> / <a href={`/brands/${brandSlug}/`}>{offer.brand}</a></>} / {offer.name}
    </div>

    <div class="offer-header">
      <h1>{offer.name}</h1>
      {offer.spec && <p style="margin: 0; color: var(--muted); font-size: 0.95em;">{offer.spec}</p>}

      {isDelisted && (
        <div class="soldout-banner">
          <strong>Out of stock</strong> — this line has sold out. Request a quote for this
          or a similar line: wholesale stock turns over daily.
        </div>
      )}

      <div class="price-display">
        {offer.currency}{offer.amount?.toFixed(2) || '—'}{basis}
        {isDelisted && <span style="font-size: 0.55em; font-weight: normal; color: var(--muted); display: block; margin-top: 0.3em;">Last listed price</span>}
        {other && <span style="font-size: 0.7em; font-weight: normal; display: block; margin-top: 0.3em;">{other}</span>}
      </div>

      <div class={`stock-badge stock-${st[0]}`}>
        {st[1]}
        {stockDetail && ` — ${stockDetail}`}
      </div>

      <div style="margin-top: 1.5em; border-top: 1px solid var(--line); padding-top: 1em;">
        <div class="spec-row">
          <span class="spec-label">Duty Status</span>
          <span class="spec-value">{offer.tier || 'Not specified'}</span>
        </div>
        {offer.terms && (
          <div class="spec-row">
            <span class="spec-label">Incoterm</span>
            <span class="spec-value">{offer.terms}</span>
          </div>
        )}
        {offer.origin && (
          <div class="spec-row">
            <span class="spec-label">Origin</span>
            <span class="spec-value">{offer.origin}</span>
          </div>
        )}
        {offer.spec && (
          <div class="spec-row">
            <span class="spec-label">Pack Size</span>
            <span class="spec-value">{offer.spec}</span>
          </div>
        )}
        <div class="spec-row">
          <span class="spec-label">Minimum Order</span>
          <span class="spec-value">
            {offer.moqLabel
              ? (offer.moqEstimated
                  ? <>Typically {offer.moqLabel}<span class="spec-hedge" title="This supplier has not stated a minimum for this line. Shown from their usual terms — confirm on enquiry.">estimated</span></>
                  : offer.moqLabel)
              : 'On request'}
          </span>
        </div>
        {offer.leadLabel && (
          <div class="spec-row">
            <span class="spec-label">Lead Time</span>
            <span class="spec-value">{offer.leadLabel}</span>
          </div>
        )}
        {offer.mixedLoad && (
          <div class="spec-row">
            <span class="spec-label">Mixed Loads</span>
            <span class="spec-value">Can be mixed with other lines</span>
          </div>
        )}
      </div>

      <div style="margin-top: 1.5em;">
        <a href={wa} class="cta-button">{isDelisted ? 'Request a Quote' : 'WhatsApp Enquiry'}</a>
        <a href={`mailto:offers@akay.ie?subject=Interest in ${offer.name}`} class="cta-button cta-secondary">Email</a>
      </div>

      <p style="font-size: 0.85em; color: var(--muted); margin-top: 1.5em; margin-bottom: 0;">
        {isDelisted
          ? 'Trade enquiries for B2B wholesale buyers. Similar lines are often available on request.'
          : 'Trade pricing for B2B wholesale buyers. Prices updated daily.'}
      </p>
    </div>

    {relatedOffers.length > 0 && (
      <div class="related-offers">
        <h2>{isDelisted ? `Available ${offer.category} Offers` : `Related ${offer.category} Offers`}</h2>
        <div class="offer-grid">
          {relatedOffers.map((rel) => (
            <div class="offer-card">
              <h3><a href={`/offers/${rel.canonicalSlug || rel.slug}/`}>{rel.name}</a></h3>
              {rel.spec && <p style="margin: 0.5em 0; color: var(--muted); font-size: 0.9em;">{rel.spec}</p>}
              <div class="price">{priceLabel(rel, { short: true })}</div>
              <a href={`/offers/${rel.canonicalSlug || rel.slug}/`} style="font-weight: 600;">View offer →</a>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="footer">
      <p>
        <a href={`/category/${categorySlug}/`}>← View all {offer.category} offers</a> |
        <a href="/">← Back to catalogue</a>
      </p>
      <p>
        AKAY Trade — <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a> | offers@akay.ie
      </p>
    </div>
  </div>
</body>
</html>
