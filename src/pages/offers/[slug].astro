---
import SiteSearch from '../../components/SiteSearch.astro';
import { getOffers } from '../../data/airtable.mjs';
import { withSlugs } from '../../lib/slug.mjs';
import { productOfferSchema, breadcrumbSchema, organizationSchema } from '../../lib/schema.mjs';
import Seo from '../../components/Seo.astro';
import { priceLabel } from '../../lib/price.mjs';
import { enquiryLink, WA_LINK, WA_DISPLAY } from '../../lib/whatsapp.mjs';

// Get all valid slugs for static generation
export async function getStaticPaths() {
  const { offers } = await getOffers();
  const allOffers = withSlugs(offers);

  return allOffers.map((offer) => ({
    params: { slug: offer.slug },
    props: { offer, allOffers },
  }));
}

const { offer, allOffers } = Astro.props;
const slug = offer.slug;

// Airtable lists the same product more than once (different lot or supplier).
// Those pages all point their canonical at one representative URL so search
// engines index a single page per product — see withSlugs() in lib/slug.mjs.
const canonicalPath = `/offers/${offer.canonicalSlug || slug}/`;

// Helper functions
function priceParts(detail = '') {
  const parts = detail.split('·').map((s) => s.trim());
  const first = parts[0] || '';
  const basis = /\/\s*bottle/i.test(first) ? '/ btl'
    : /\/\s*case/i.test(first) ? '/ case'
    : /\/\s*unit/i.test(first) ? '/ unit' : '';
  const msg = basis === '/ btl' ? 'per bottle' : basis === '/ case' ? 'per case' : basis === '/ unit' ? 'per unit' : '';
  const other = parts.slice(1).join(' · ');
  return { basis, other, msg };
}

const STOCK = { in: ['ok', 'In stock'], warn: ['warn', 'Limited'], enq: ['neu', 'Enquire'] };

const { basis, other, msg } = priceParts(offer.priceDetail);
const st = STOCK[offer.stock] || STOCK.enq;
const wa = enquiryLink(offer, msg);

// Category slug for linking
const categorySlug = offer.category.toLowerCase().replace(/\s+/g, '-');

// Related offers (same category, max 4)
const relatedOffers = allOffers
  .filter(
    (o) => o.category === offer.category &&
            (o.id || `${o.brand}-${o.name}`) !== (offer.id || `${offer.brand}-${offer.name}`)
  )
  .sort(() => Math.random() - 0.5)
  .slice(0, 4);

// Build schemas
const orgSchema = organizationSchema();
const productSchema = productOfferSchema(offer, offer.canonicalSlug || slug);
const breadcrumbData = breadcrumbSchema(offer.name, offer.category, offer.canonicalSlug || slug);

// Short availability phrase for the meta description (the on-page version
// with case counts is built further down).
const stockLine = offer.stock === 'in'
  ? (offer.qty ? `${offer.qty.toLocaleString()} cases in stock` : 'in stock')
  : offer.stock === 'warn' ? 'limited availability' : 'enquire for availability';

// Title and meta. priceLabel() reads the parsed basis, so a per-bottle line
// never gets a "/case" price in its SERP snippet.
const price = priceLabel(offer);

// Product names run to 200+ characters on multi-variant lines. Budget the
// title so the whole string stays near 110 characters — the product name is
// the part that gets shortened, since the pack size and price are what make
// one line distinguishable from the next.
const titleTail = `${offer.spec ? ` ${offer.spec}` : ''} wholesale — ${price} | AKAY Trade`;
const nameBudget = Math.max(24, 110 - titleTail.length);
const shortName = offer.name.length > nameBudget
  ? `${offer.name.slice(0, nameBudget - 1).trimEnd().replace(/[\s,;·—-]+$/, '')}…`
  : offer.name;

const pageTitle = `${shortName}${titleTail}`;
const pageDesc = [
  `Buy ${offer.name}${offer.spec ? ` (${offer.spec})` : ''} wholesale from AKAY Trade`,
  price,
  offer.tier,
  offer.terms,
  offer.origin ? `origin ${offer.origin}` : null,
  stockLine,
].filter(Boolean).join(' · ').slice(0, 300);

// Determine availability status for display
let stockStatus = 'Enquire on request';
let stockDetail = '';
if (offer.stock === 'in') {
  stockStatus = 'In stock';
  if (offer.qty) {
    stockDetail = `${offer.qty.toLocaleString()} cases available`;
  }
} else if (offer.stock === 'warn') {
  stockStatus = 'Limited availability';
}
---

<!doctype html>
<html lang="en">
<head>
  <Seo
    title={pageTitle}
    description={pageDesc}
    ogTitle={shortName}
    path={canonicalPath}
    type="product"
    schemas={[orgSchema, productSchema, breadcrumbData]}
  />

  <style>
    :root {
      --paper: #F7F5F0;
      --paper-2: #EFEDE4;
      --card: #FFFFFF;
      --ink: #17140F;
      --ink-soft: #41473F;
      --muted: #767E72;
      --line: #E4E0D4;
      --brass: #B4231F;
      --ok: #0E7A3B;
      --ok-bg: #E2F0E5;
      --warn: #9A6A12;
      --warn-bg: #F5E9CE;
      --neu: #5C6A78;
      --neu-bg: #E9ECEF;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F;
        --paper-2: #081009;
        --card: #13201A;
        --ink: #F1EFE7;
        --ink-soft: #C6CEC4;
        --muted: #8A968A;
        --line: #243029;
        --brass: #EC5A52;
        --ok: #5FC97E;
        --ok-bg: #123021;
        --warn: #E0B65C;
        --warn-bg: #31280F;
        --neu: #9AA7B4;
        --neu-bg: #1B2530;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    body {
      margin: 0;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 1em 0 0.5em;
    }
    h2 {
      font: 600 1.3em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }
    .breadcrumb a {
      color: var(--brass);
    }

    .offer-header {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 2em;
      margin-bottom: 2em;
      box-shadow: var(--shadow);
    }

    .price-display {
      font: 600 1.8em var(--serif);
      color: var(--brass);
      margin: 0.5em 0;
    }

    .stock-badge {
      display: inline-block;
      padding: 0.4em 0.8em;
      border-radius: 6px;
      font-size: 0.9em;
      font-weight: 600;
      margin: 0.5em 0;
    }

    .stock-ok {
      background: var(--ok-bg);
      color: var(--ok);
    }
    .stock-warn {
      background: var(--warn-bg);
      color: var(--warn);
    }
    .stock-neu {
      background: var(--neu-bg);
      color: var(--neu);
    }

    .spec-row {
      display: flex;
      justify-content: space-between;
      padding: 0.8em 0;
      border-bottom: 1px solid var(--line);
    }
    .spec-row:last-child {
      border-bottom: none;
    }

    .spec-label {
      color: var(--muted);
      font-weight: 600;
    }
    .spec-value {
      text-align: right;
      color: var(--ink);
    }

    .cta-button {
      display: inline-block;
      background: var(--brass);
      color: white;
      padding: 0.8em 1.6em;
      border-radius: 6px;
      font-weight: 600;
      margin: 1em 0.5em 1em 0;
      border: none;
      cursor: pointer;
    }
    .cta-button:hover {
      background: var(--brass);
      text-decoration: none;
      opacity: 0.9;
    }

    .cta-secondary {
      background: var(--paper-2);
      color: var(--ink);
      border: 1px solid var(--line);
    }

    .related-offers {
      margin: 3em 0 0;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5em;
      margin-top: 1em;
    }

    .offer-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5em;
      box-shadow: var(--shadow);
    }

    .offer-card h3 {
      margin: 0 0 0.5em;
      font: 600 1.1em var(--serif);
      color: var(--ink);
    }

    .offer-card .price {
      font: 600 1.3em var(--serif);
      color: var(--brass);
      margin: 0.5em 0;
    }

    .footer {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.9em;
      margin-top: 3em;
    }

    .footer a {
      color: var(--brass);
    }
  </style>
</head>
<body>
  <div class="container">
    <SiteSearch />
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${categorySlug}/`}>{offer.category}</a> / {offer.name}
    </div>

    <div class="offer-header">
      <h1>{offer.name}</h1>
      {offer.spec && <p style="margin: 0; color: var(--muted); font-size: 0.95em;">{offer.spec}</p>}

      <div class="price-display">
        {offer.currency}{offer.amount?.toFixed(2) || '—'}{basis}
        {other && <span style="font-size: 0.7em; font-weight: normal; display: block; margin-top: 0.3em;">{other}</span>}
      </div>

      <div class={`stock-badge stock-${st[0]}`}>
        {st[1]}
        {stockDetail && ` — ${stockDetail}`}
      </div>

      <div style="margin-top: 1.5em; border-top: 1px solid var(--line); padding-top: 1em;">
        <div class="spec-row">
          <span class="spec-label">Duty Status</span>
          <span class="spec-value">{offer.tier || 'Not specified'}</span>
        </div>
        {offer.terms && (
          <div class="spec-row">
            <span class="spec-label">Incoterm</span>
            <span class="spec-value">{offer.terms}</span>
          </div>
        )}
        {offer.origin && (
          <div class="spec-row">
            <span class="spec-label">Origin</span>
            <span class="spec-value">{offer.origin}</span>
          </div>
        )}
        {offer.spec && (
          <div class="spec-row">
            <span class="spec-label">Pack Size</span>
            <span class="spec-value">{offer.spec}</span>
          </div>
        )}
      </div>

      <div style="margin-top: 1.5em;">
        <a href={wa} class="cta-button">WhatsApp Enquiry</a>
        <a href={`mailto:offers@akay.ie?subject=Interest in ${offer.name}`} class="cta-button cta-secondary">Email</a>
      </div>

      <p style="font-size: 0.85em; color: var(--muted); margin-top: 1.5em; margin-bottom: 0;">
        Trade pricing for B2B wholesale buyers. Prices updated daily.
      </p>
    </div>

    {relatedOffers.length > 0 && (
      <div class="related-offers">
        <h2>Related {offer.category} Offers</h2>
        <div class="offer-grid">
          {relatedOffers.map((rel) => (
            <div class="offer-card">
              <h3><a href={`/offers/${rel.canonicalSlug || rel.slug}/`}>{rel.name}</a></h3>
              {rel.spec && <p style="margin: 0.5em 0; color: var(--muted); font-size: 0.9em;">{rel.spec}</p>}
              <div class="price">{rel.currency}{rel.amount?.toFixed(2) || '—'} / case</div>
              <a href={`/offers/${rel.canonicalSlug || rel.slug}/`} style="font-weight: 600;">View offer →</a>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="footer">
      <p>
        <a href={`/category/${categorySlug}/`}>← View all {offer.category} offers</a> |
        <a href="/">← Back to catalogue</a>
      </p>
      <p>
        AKAY Trade — <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a> | offers@akay.ie
      </p>
    </div>
  </div>
</body>
</html>
