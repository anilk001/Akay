---
import { getCatalogue } from '../../lib/catalogue.mjs';
import { productOfferSchema, breadcrumbList, organizationSchema } from '../../lib/schema.mjs';
import { WA_LINK, WA_DISPLAY } from '../../lib/whatsapp.mjs';
import { GLOSSARY_HREF } from '../../lib/glossary.mjs';
import OfferCard from '../../components/OfferCard.astro';
import RfqBasket from '../../components/RfqBasket.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
  // Slugs, price basis and stock labels all come from the shared catalogue now,
  // so this page cannot disagree with the index or the aggregation pages.
  const { offers } = await getCatalogue();
  return offers.map((offer) => ({
    params: { slug: offer.slug },
    props: { offer, allOffers: offers },
  }));
}

const { offer, allOffers } = Astro.props;
const slug = offer.slug;
const { basis, other, st } = offer;
const wa = offer.wa;
const categorySlug = offer.categorySlug;

// Related offers, same category. Previously shuffled with Math.random(), which
// meant every rebuild rewrote the block on all ~2,900 pages — churn in the diff
// and in Netlify's upload for no reader benefit. Now it walks forward from this
// offer's own position, so the picks are stable per offer and still varied
// across the catalogue.
const pool = allOffers.filter((o) => o.category === offer.category && o.id !== offer.id);
const startAt = pool.findIndex((o) => o.slug > offer.slug);
const relatedOffers = pool.length
  ? Array.from({ length: Math.min(4, pool.length) }, (_, i) => pool[((startAt < 0 ? 0 : startAt) + i) % pool.length])
  : [];

const orgSchema = organizationSchema();
const productSchema = productOfferSchema(offer, slug);
// The trail now includes the brand step, matching the brief's
// Home -> Category -> Brand -> Offer.
const breadcrumbData = breadcrumbList([
  { name: 'Home', path: '/' },
  { name: offer.category, path: `/category/${categorySlug}/` },
  ...(offer.brandSlug ? [{ name: offer.brand, path: `/brand/${offer.brandSlug}/` }] : []),
  { name: offer.name, path: `/offers/${slug}/` },
]);

const pageTitle = `${offer.name} ${offer.spec || ''} wholesale — ${offer.priceLabel} | AKAY Trade`;
const pageDesc = `${offer.name} ${offer.spec || ''} wholesale: ${offer.priceLabel}, ${offer.tier || 'trade pricing'}, ${offer.terms || 'terms available'}. Buy by the case from AKAY Trade.`;

// Determine availability status for display
let stockDetail = '';
if (offer.stock === 'in' && offer.qty) {
  stockDetail = `${offer.qty.toLocaleString()} cases available`;
}

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="icon" href="/akay-bird.png" />
  <link rel="canonical" href={`https://offers.akay.ie/offers/${slug}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AKAY Trade" />
  <meta property="og:url" content={`https://offers.akay.ie/offers/${slug}/`} />
  <meta property="og:title" content={offer.name} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="https://offers.akay.ie/akay-bird.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={offer.name} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="robots" content="max-snippet:-1, max-image-preview:large" />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <style>
    :root {
      /* Canonical token set, identical to src/layouts/BaseLayout.astro.
         These templates each carried a subset that omitted --mono, --line-soft,
         --forest, --brass-2 and --lime. That was survivable while every card was
         hand-written per page, but the shared OfferCard and SiteFooter use all
         of them — a missing --forest renders the Enquire button with no
         background at all. */
      --paper: #F7F5F0; --paper-2: #EFEDE4; --card: #FFFFFF;
      --ink: #17140F; --ink-soft: #41473F; --muted: #767E72;
      --line: #E4E0D4; --line-soft: #ECE8DD;
      --brass: #B4231F; --brass-2: #D0362E; --forest: #0E7A3B; --lime: #6FA82E;
      --ok: #0E7A3B; --ok-bg: #E2F0E5; --warn: #9A6A12; --warn-bg: #F5E9CE;
      --neu: #5C6A78; --neu-bg: #E9ECEF;
      --shadow: 0 1px 2px rgba(20, 33, 26, 0.06), 0 6px 20px -8px rgba(20, 33, 26, 0.14);
      --radius: 14px;
      --serif: "Hoefler Text", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --mono: ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0C140F; --paper-2: #081009; --card: #13201A;
        --ink: #F1EFE7; --ink-soft: #C6CEC4; --muted: #8A968A;
        --line: #243029; --line-soft: #1B2620;
        --brass: #EC5A52; --brass-2: #F26E66; --forest: #37B866; --lime: #9BD84F;
        --ok: #5FC97E; --ok-bg: #123021; --warn: #E0B65C; --warn-bg: #31280F;
        --neu: #9AA7B4; --neu-bg: #1B2530;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 28px -12px rgba(0, 0, 0, 0.6);
      }
    }

    body {
      margin: 0;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      font: 16px / 1.5 var(--sans);
    }
    h1 {
      font: 600 2em var(--serif);
      margin: 0.2em 0 0.5em;
    }
    h2 {
      font: 600 1.3em var(--serif);
      margin: 1.5em 0 0.5em;
      color: var(--ink-soft);
    }
    a {
      color: var(--brass);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      /* Clear the fixed basket bar at the foot of the page. */
      padding-bottom: 70px;
    }

    .brand-eyebrow {
      display: inline-block;
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brass);
      text-decoration: none;
      margin-bottom: 2px;
    }
    .brand-eyebrow:hover { text-decoration: underline; }

    /* §5 — present only when the line actually carries logistics data. */
    .logistics {
      margin-top: 1.5em;
      padding-top: 1em;
      border-top: 1px solid var(--line);
    }
    .logistics h2 {
      margin: 0 0 0.3em;
      font: 600 1em var(--sans);
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .basket-add {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 1.5em;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--paper-2);
      font-size: 0.88em;
      color: var(--ink-soft);
      cursor: pointer;
    }
    .basket-add input {
      width: 16px;
      height: 16px;
      accent-color: var(--ok);
      flex-shrink: 0;
      margin: 0;
      cursor: pointer;
    }

    .breadcrumb {
      font-size: 0.9em;
      color: var(--muted);
      margin-bottom: 2em;
    }
    .breadcrumb a {
      color: var(--brass);
    }

    .offer-header {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 2em;
      margin-bottom: 2em;
      box-shadow: var(--shadow);
    }

    .price-display {
      font: 600 1.8em var(--serif);
      color: var(--brass);
      margin: 0.5em 0;
    }

    .stock-badge {
      display: inline-block;
      padding: 0.4em 0.8em;
      border-radius: 6px;
      font-size: 0.9em;
      font-weight: 600;
      margin: 0.5em 0;
    }

    .stock-ok {
      background: var(--ok-bg);
      color: var(--ok);
    }
    .stock-warn {
      background: var(--warn-bg);
      color: var(--warn);
    }
    .stock-neu {
      background: var(--neu-bg);
      color: var(--neu);
    }

    .spec-row {
      display: flex;
      justify-content: space-between;
      padding: 0.8em 0;
      border-bottom: 1px solid var(--line);
    }
    .spec-row:last-child {
      border-bottom: none;
    }

    .spec-label {
      color: var(--muted);
      font-weight: 600;
    }
    .spec-value {
      text-align: right;
      color: var(--ink);
    }

    .cta-button {
      display: inline-block;
      background: var(--brass);
      color: white;
      padding: 0.8em 1.6em;
      border-radius: 6px;
      font-weight: 600;
      margin: 1em 0.5em 1em 0;
      border: none;
      cursor: pointer;
    }
    .cta-button:hover {
      background: var(--brass);
      text-decoration: none;
      opacity: 0.9;
    }

    .cta-secondary {
      background: var(--paper-2);
      color: var(--ink);
      border: 1px solid var(--line);
    }

    .related-offers {
      margin: 3em 0 0;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5em;
      margin-top: 1em;
    }

    /* Related offers render through OfferCard.astro, which carries its own
       styles; a page's scoped CSS does not reach into a child component. */

    .footer {
      text-align: center;
      padding: 2em 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.9em;
      margin-top: 3em;
    }

    .footer a {
      color: var(--brass);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${categorySlug}/`}>{offer.category}</a>
      {offer.brandSlug && <> / <a href={`/brand/${offer.brandSlug}/`}>{offer.brand}</a></>}
      / {offer.name}
    </div>

    <div class="offer-header">
      {offer.brandSlug && <a class="brand-eyebrow" href={`/brand/${offer.brandSlug}/`}>{offer.brand}</a>}
      <h1>{offer.name}</h1>
      {offer.spec && <p style="margin: 0; color: var(--muted); font-size: 0.95em;">{offer.spec}</p>}

      <div class="price-display">
        {offer.currency}{offer.amount?.toFixed(2) || '—'}{basis}
        {other && <span style="font-size: 0.7em; font-weight: normal; display: block; margin-top: 0.3em;">{other}</span>}
      </div>

      <div class={`stock-badge stock-${st[0]}`}>
        {st[1]}
        {stockDetail && ` — ${stockDetail}`}
      </div>

      <div style="margin-top: 1.5em; border-top: 1px solid var(--line); padding-top: 1em;">
        <div class="spec-row">
          <span class="spec-label">Customs status</span>
          <span class="spec-value">
            {offer.tier
              ? <a href={GLOSSARY_HREF(offer.tier)}>{offer.tier}</a>
              : 'Ask us'}
          </span>
        </div>
        {offer.terms && (
          <div class="spec-row">
            <span class="spec-label">Incoterm</span>
            <span class="spec-value">{offer.terms}</span>
          </div>
        )}
        {offer.origin && (
          <div class="spec-row">
            <span class="spec-label">Origin</span>
            <span class="spec-value">{offer.origin}</span>
          </div>
        )}
        {offer.spec && (
          <div class="spec-row">
            <span class="spec-label">Pack Size</span>
            <span class="spec-value">{offer.spec}</span>
          </div>
        )}
      </div>

      {offer.logistics.length > 0 && (
        <div class="logistics">
          <h2>Logistics</h2>
          <div>
            {offer.logistics.map((row) => (
              <div class="spec-row">
                <span class="spec-label">{row.label}</span>
                <span class="spec-value">{row.value}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {offer.id && (
        <label class="basket-add">
          <input
            type="checkbox"
            class="basket-cb"
            data-offer-id={offer.id}
            data-desc={offer.name + (offer.spec ? ` ${offer.spec}` : '')}
            data-price={offer.priceLabel}
            data-category={offer.category}
          />
          <span>Add this line to a quote request &mdash; tick more as you browse, then send one enquiry</span>
        </label>
      )}

      <div style="margin-top: 1.5em;">
        <a href={wa} class="cta-button">WhatsApp Enquiry</a>
        <a href={`mailto:offers@akay.ie?subject=Interest in ${offer.name}`} class="cta-button cta-secondary">Email</a>
      </div>

      <p style="font-size: 0.85em; color: var(--muted); margin-top: 1.5em; margin-bottom: 0;">
        Trade pricing for B2B wholesale buyers. Prices updated daily.
      </p>
    </div>

    {relatedOffers.length > 0 && (
      <div class="related-offers">
        <h2>Related {offer.category} Offers</h2>
        <div class="offer-grid">
          {relatedOffers.map((rel) => <OfferCard offer={rel} basket={false} context="index" />)}
        </div>
      </div>
    )}

    <nav class="footer">
      <p>
        <a href={`/category/${categorySlug}/`}>All {offer.category} offers</a>
        {offer.brandSlug && <> · <a href={`/brand/${offer.brandSlug}/`}>All {offer.brand} offers</a></>}
        · <a href="/trade-terms/">Trade terms</a>
        · <a href="/customs-glossary/">Customs glossary</a>
        · <a href="/">Back to catalogue</a>
      </p>
      <p>
        AKAY Trade — <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a> | offers@akay.ie
      </p>
    </nav>
    <RfqBasket />
  </div>
  <SiteFooter />
</body>
</html>
