---
// Shared layout for all non-homepage pages (offer, category, guide, about).
// Carries the head essentials the SEO brief requires on every page:
// unique title/description, canonical, robots snippet hints, Organization
// JSON-LD (@id-referenced by Product schema on offer pages), GA4, and the
// site-wide header/footer whose links make every page reachable by crawlers.
import { categorySlug } from '../lib/slug.mjs';

interface Props {
  title: string;
  description: string;
  path: string;              // canonical path, must start and end with '/'
  schema?: object[];         // page-specific JSON-LD blocks
  categories?: string[];     // for footer links (fallback list used if absent)
}

const { title, description, path, schema = [], categories = [] } = Astro.props;
const SITE = 'https://offers.akay.ie';
const canonical = SITE + path;
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || 'G-FW42J5609V';

// Organization entity — identical on every page, @id lets offer schema
// reference the seller without repeating it (SEO brief §4).
export const ORG_SCHEMA = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://offers.akay.ie/#org',
  name: 'Akay Irl Ltd',
  alternateName: 'AKAY Trade',
  url: 'https://offers.akay.ie/',
  logo: 'https://offers.akay.ie/akay-bird.png',
  description:
    'Ireland-based B2B wholesale trading company dealing in spirits, beer, soft drinks and FMCG products by the case and pallet. Duty-paid and export (under-bond) supply across Europe, Asia and the Caribbean.',
  email: 'hello@akay.ie',
  telephone: '+353872382368',
  address: { '@type': 'PostalAddress', addressLocality: 'Shannon', addressCountry: 'IE' },
  vatID: 'IE8250418E',
  identifier: { '@type': 'PropertyValue', propertyID: 'CRO', value: '250418' },
  areaServed: ['Europe', 'Asia', 'Caribbean', 'Middle East', 'Africa'],
  knowsAbout: [
    'wholesale spirits', 'wholesale beer', 'FMCG wholesale',
    'duty-paid trading', 'under-bond trading', 'parallel trading',
  ],
};

const footerCats = categories.length
  ? categories
  : ['Spirits', 'Beer', 'Soft Drinks', 'Grocery', 'Toiletries', 'Confectionery'];

const GUIDES = [
  ['/guides/t1-vs-t2-duty-status/', 'T1 vs T2 duty status'],
  ['/guides/incoterms-exw-dap-cfr/', 'Incoterms explained'],
  ['/guides/how-to-buy-wholesale-spirits-eu/', 'How to buy wholesale'],
  ['/guides/requirement-list-format/', 'Requirement list format'],
];

const jsonLd = [ORG_SCHEMA, ...schema];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="max-snippet:-1, max-image-preview:large" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`${SITE}/akay-bird.png`} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/akay-bird.png" />
  {jsonLd.map((obj) => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
  {GA4_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    </>
  )}
  <style>
    :root{
      --paper:#F7F5F0; --paper-2:#EFEDE4; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --line-soft:#ECE8DD;
      --brass:#B4231F; --brass-2:#D0362E; --forest:#0E7A3B; --lime:#6FA82E;
      --ok:#0E7A3B; --ok-bg:#E2F0E5; --warn:#9A6A12; --warn-bg:#F5E9CE; --neu:#5C6A78; --neu-bg:#E9ECEF;
      --shadow:0 1px 2px rgba(20,33,26,.06),0 6px 20px -8px rgba(20,33,26,.14);
      --radius:14px;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      --mono:ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme:dark){
      :root{
        --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
        --muted:#8A968A; --line:#243029; --line-soft:#1B2620;
        --brass:#EC5A52; --brass-2:#F26E66; --forest:#37B866; --lime:#9BD84F;
        --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
        --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
      }
    }
    :root[data-theme="light"]{
      --paper:#F7F5F0; --paper-2:#EFEDE4; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --line-soft:#ECE8DD; --brass:#B4231F; --brass-2:#D0362E; --forest:#0E7A3B; --lime:#6FA82E;
      --ok:#0E7A3B; --ok-bg:#E2F0E5; --warn:#9A6A12; --warn-bg:#F5E9CE; --neu:#5C6A78; --neu-bg:#E9ECEF;
    }
    :root[data-theme="dark"]{
      --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
      --muted:#8A968A; --line:#243029; --line-soft:#1B2620; --brass:#EC5A52; --brass-2:#F26E66; --forest:#37B866; --lime:#9BD84F;
      --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
    }
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.55;-webkit-font-smoothing:antialiased}
    .wrap{max-width:980px;margin:0 auto;padding:0 20px}

    header.bar{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--paper) 86%,transparent);
      backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
    .bar-in{display:flex;align-items:center;gap:16px;height:60px}
    .mark{display:inline-flex;align-items:center;gap:9px;font-family:var(--serif);font-weight:600;font-size:24px;letter-spacing:.02em;color:var(--ink);text-decoration:none;line-height:1}
    .logo-slot{flex-shrink:0;height:32px;width:auto}
    .mark b{color:var(--brass)}
    .dot{width:6px;height:6px;border-radius:50%;background:var(--brass-2);display:inline-block;margin:0 2px 2px 2px}
    nav.top{display:flex;gap:16px;margin-left:6px;flex-wrap:wrap}
    nav.top a{color:var(--ink-soft);text-decoration:none;font-size:13.5px}
    nav.top a:hover{color:var(--brass)}
    .bar-spacer{flex:1}
    .theme-btn{border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:9px;
      height:34px;padding:0 12px;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
    .theme-btn:hover{border-color:var(--brass-2);color:var(--ink)}

    main{padding:30px 0 46px}
    .crumbs{font-family:var(--mono);font-size:12px;color:var(--muted);margin:0 0 18px}
    .crumbs a{color:var(--muted)}
    .crumbs a:hover{color:var(--brass)}
    h1{font-family:var(--serif);font-weight:600;font-size:clamp(26px,4.5vw,38px);line-height:1.08;margin:0 0 10px;letter-spacing:-.01em;text-wrap:balance}
    h2{font-family:var(--serif);font-weight:600;font-size:22px;margin:34px 0 10px}
    p{max-width:72ch}
    a{color:var(--brass)}
    .lede{color:var(--ink-soft);font-size:16.5px;margin:0 0 6px;max-width:64ch}

    .btn{display:inline-flex;align-items:center;gap:8px;background:var(--forest);color:var(--paper);
      text-decoration:none;font-size:14px;font-weight:600;padding:10px 16px;border-radius:10px;border:1px solid transparent;transition:.14s}
    :root[data-theme="dark"] .btn{color:#0A140F}
    @media (prefers-color-scheme:dark){.btn{color:#0A140F}}
    .btn:hover{background:var(--brass);color:#fff}
    .btn.ghost{background:transparent;color:var(--ink-soft);border-color:var(--line)}
    .btn.ghost:hover{color:var(--brass);border-color:var(--brass-2);background:transparent}

    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-top:14px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:8px}
    .card a.title{font-family:var(--serif);font-size:17.5px;font-weight:600;line-height:1.2;color:var(--ink);text-decoration:none}
    .card a.title:hover{color:var(--brass)}
    .card .spec{font-family:var(--mono);font-size:12px;color:var(--ink-soft)}
    .card .price{font-family:var(--mono);font-size:16px;font-weight:600}
    .card .meta{font-family:var(--mono);font-size:11.5px;color:var(--muted)}

    .facts{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);
      margin:20px 0;padding:6px 18px}
    .facts dl{display:grid;grid-template-columns:max-content 1fr;gap:8px 22px;margin:12px 0}
    .facts dt{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:.03em}
    .facts dd{margin:0;font-size:14.5px}
    .pill{font-size:11px;font-weight:600;padding:4px 9px;border-radius:999px;white-space:nowrap;font-family:var(--sans)}
    .pill.ok{background:var(--ok-bg);color:var(--ok)}
    .pill.warn{background:var(--warn-bg);color:var(--warn)}
    .pill.neu{background:var(--neu-bg);color:var(--neu)}
    .updated{font-family:var(--mono);font-size:12px;color:var(--muted)}

    footer{border-top:1px solid var(--line);padding:28px 0 46px;color:var(--muted);font-size:13px;margin-top:30px}
    footer .cols{display:flex;flex-wrap:wrap;gap:28px 54px;margin-bottom:18px}
    footer h3{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
    footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
    footer a{color:var(--ink-soft);text-decoration:none}
    footer a:hover{color:var(--brass)}
    footer .note{max-width:66ch;line-height:1.6}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</head>
<body>
  <header class="bar">
    <div class="wrap bar-in">
      <a class="mark" href="/" aria-label="AKAY home">
        <img class="logo-slot" src="/akay-bird.png" alt="" width="320" height="279" />AKAY<span class="dot"></span><b>trade</b>
      </a>
      <nav class="top" aria-label="Site">
        <a href="/">Catalogue</a>
        <a href="/guides/how-to-buy-wholesale-spirits-eu/">How to buy</a>
        <a href="/about/">About</a>
      </nav>
      <span class="bar-spacer"></span>
      <button class="theme-btn" id="themeBtn" aria-label="Toggle light or dark theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
        <span id="themeLbl">Theme</span>
      </button>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="cols">
        <div>
          <h3>Categories</h3>
          <ul>
            {footerCats.map((c) => (
              <li><a href={`/category/${categorySlug(c)}/`}>{c}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Guides</h3>
          <ul>
            {GUIDES.map(([href, label]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Company</h3>
          <ul>
            <li><a href="/about/">About AKAY</a></li>
            <li><a href="mailto:offers@akay.ie">offers@akay.ie</a></li>
            <li><a href="https://wa.me/353872382368" rel="noopener">WhatsApp enquiries</a></li>
          </ul>
        </div>
      </div>
      <div class="note">
        Trade buyers only. Prices are indicative and shown per the listing basis; supplier identity, buy prices and margins are never published.
        <strong>T1</strong> = export / under-bond · <strong>T2</strong> = duty-paid, for sale in the EU. © Akay Irl Ltd, Shannon, Ireland.
      </div>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    document.getElementById('themeBtn').addEventListener('click', () => {
      const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      document.getElementById('themeLbl').textContent = next === 'dark' ? 'Light' : 'Dark';
    });
  </script>
</body>
</html>
