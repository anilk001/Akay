---
// Shared shell for every page added by this build, plus the category pages.
//
// Before this, five templates each carried their own copy of the design tokens
// and their own header markup, and they had already drifted — the catalogue had
// a theme toggle and a logo, the category and offer pages had neither, and the
// category page's colour tokens were a subset that omitted --forest and
// --line-soft. New pages share one shell so that stops multiplying.
//
// The index and offer templates keep their bespoke heads for now: they are the
// two highest-traffic templates and rebuilding them into this layout is a much
// larger change than the brief asks for. They pull in the same SiteFooter, so
// the §2 credibility block is on every page either way.
import SiteFooter from '../components/SiteFooter.astro';
import { LOCALES, DEFAULT_LOCALE } from '../i18n/locales.mjs';
import { UI } from '../i18n/content.mjs';

const {
  title,
  description,
  canonical,
  lang = 'en',
  noindex = false,
  jsonLd = [],
  // Path shared by all language versions of this page, e.g. '/trade-terms/'.
  // Supplying it emits the reciprocal hreflang set (§6); omitting it means the
  // page exists in English only and gets no alternates.
  i18nPath = null,
  wide = false,
} = Astro.props;

const SITE = 'https://offers.akay.ie';
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || 'G-FW42J5609V';
const canonicalUrl = canonical || `${SITE}${Astro.url.pathname.replace(/\/?$/, '/')}`;
const dir = LOCALES[lang]?.dir || 'ltr';

// hreflang must be reciprocal to be honoured: every language version lists
// every other one, plus x-default pointing at English.
const alternates = i18nPath
  ? [
      ...Object.keys(LOCALES).map((code) => ({
        hreflang: code,
        href: code === DEFAULT_LOCALE ? `${SITE}${i18nPath}` : `${SITE}/${code}${i18nPath}`,
      })),
      { hreflang: 'x-default', href: `${SITE}${i18nPath}` },
    ]
  : [];

const home = lang === DEFAULT_LOCALE ? '/' : `/${lang}/`;

// Header nav follows the page's language. Brand and offer pages exist only in
// English, so on a translated page those two links point at the English
// catalogue — which is correct, not a gap: the catalogue rows are English by
// design (see src/i18n/content.mjs).
const t = UI[lang];
const nav = [
  [t ? t.categories : 'Categories', lang === DEFAULT_LOCALE ? '/categories/' : `/${lang}/categories/`],
  [t ? t.brands : 'Brands', '/brands/'],
  [t ? t.tradeTerms : 'Trade terms', lang === DEFAULT_LOCALE ? '/trade-terms/' : `/${lang}/trade-terms/`],
  [t ? t.customs : 'Customs', lang === DEFAULT_LOCALE ? '/customs-glossary/' : `/${lang}/customs-glossary/`],
];
---

<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/akay-bird.png" />
  <link rel="canonical" href={canonicalUrl} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="max-snippet:-1, max-image-preview:large" />}
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AKAY Trade" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${SITE}/akay-bird.png`} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  {GA4_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    </>
  )}

  {jsonLd.filter(Boolean).map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}

  <style is:global>
    :root{
      --paper:#F7F5F0; --paper-2:#EFEDE4; --card:#FFFFFF; --ink:#17140F; --ink-soft:#41473F;
      --muted:#767E72; --line:#E4E0D4; --line-soft:#ECE8DD;
      --brass:#B4231F; --brass-2:#D0362E; --forest:#0E7A3B; --lime:#6FA82E;
      --ok:#0E7A3B; --ok-bg:#E2F0E5; --warn:#9A6A12; --warn-bg:#F5E9CE; --neu:#5C6A78; --neu-bg:#E9ECEF;
      --shadow:0 1px 2px rgba(20,33,26,.06),0 6px 20px -8px rgba(20,33,26,.14);
      --radius:14px;
      --serif:"Hoefler Text","Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      --mono:ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
    }
    @media (prefers-color-scheme:dark){
      :root:not([data-theme="light"]){
        --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
        --muted:#8A968A; --line:#243029; --line-soft:#1B2620;
        --brass:#EC5A52; --brass-2:#F26E66; --forest:#37B866; --lime:#9BD84F;
        --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
        --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
      }
    }
    :root[data-theme="dark"]{
      --paper:#0C140F; --paper-2:#081009; --card:#13201A; --ink:#F1EFE7; --ink-soft:#C6CEC4;
      --muted:#8A968A; --line:#243029; --line-soft:#1B2620; --brass:#EC5A52; --brass-2:#F26E66;
      --forest:#37B866; --lime:#9BD84F;
      --ok:#5FC97E; --ok-bg:#123021; --warn:#E0B65C; --warn-bg:#31280F; --neu:#9AA7B4; --neu-bg:#1B2530;
      --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.6);
    }
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}
    .wrap{max-width:1200px;margin:0 auto;padding:0 20px}
    .wrap-narrow{max-width:820px;margin:0 auto;padding:0 20px}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>

  <style>
    header.bar{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--paper) 86%,transparent);
      backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
    .bar-in{display:flex;align-items:center;gap:16px;height:60px;max-width:1200px;margin:0 auto;padding:0 20px}
    .mark{display:inline-flex;align-items:center;gap:9px;font-family:var(--serif);font-weight:600;font-size:26px;
      letter-spacing:.02em;color:var(--ink);text-decoration:none;line-height:1}
    .logo-slot{flex-shrink:0;height:34px;width:auto;filter:drop-shadow(0 1px 2px rgba(0,0,0,.18))}
    .mark b{color:var(--brass)}
    .dot{width:6px;height:6px;border-radius:50%;background:var(--brass-2);display:inline-block;margin:0 2px 2px 2px}
    .bar-nav{display:flex;gap:16px;font-size:13.5px}
    .bar-nav a{color:var(--ink-soft);text-decoration:none;white-space:nowrap}
    .bar-nav a:hover{color:var(--brass)}
    .bar-spacer{flex:1}
    .theme-btn{border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:9px;
      height:34px;padding:0 12px;font-size:13px;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
    .theme-btn:hover{border-color:var(--brass-2);color:var(--ink)}
    main{padding:30px 0 46px}
    @media (max-width:720px){.bar-nav{display:none}}
  </style>
</head>
<body>
  <header class="bar">
    <div class="bar-in">
      <a class="mark" href={home} aria-label="AKAY home">
        <img class="logo-slot" src="/akay-bird.png" alt="" width="320" height="279" />AKAY<span class="dot"></span><b>trade</b>
      </a>
      <nav class="bar-nav" aria-label="Catalogue">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <span class="bar-spacer"></span>
      <button class="theme-btn" id="themeBtn" aria-label="Toggle light or dark theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
        <span id="themeLbl">Theme</span>
      </button>
    </div>
  </header>

  <main class={wide ? 'wrap' : 'wrap-narrow'}>
    <slot />
  </main>

  <slot name="footer-extra" />
  <SiteFooter />

  <script>
    const root = document.documentElement;
    document.getElementById('themeBtn')?.addEventListener('click', () => {
      const cur = root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      const lbl = document.getElementById('themeLbl');
      if (lbl) lbl.textContent = next === 'dark' ? 'Light' : 'Dark';
    });
  </script>
</body>
</html>
