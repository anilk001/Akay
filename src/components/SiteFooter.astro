---
// The one site footer: company registration, contact, and the links a buyer
// needs from any page. Class names are prefixed `sf-` for the same reason the
// header's are `sh-`: some pages style bare classes (.note, .wrap) globally.
import { LEGAL_NAME, CRO_NUMBER, VAT_NUMBER, companyAddressLine } from '../lib/site.mjs';
import { WA_LINK, WA_DISPLAY } from '../lib/whatsapp.mjs';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="sf-in">
    <div class="sf-col sf-about">
      <p class="sf-name">AKAY <b>trade</b></p>
      <p>Wholesale spirits, beer, soft drinks and FMCG by the case and pallet — T1 export and T2 duty-paid. Prices are indicative and shown per the listing basis; supplier identity, buy prices and margins are never published.</p>
    </div>
    <nav class="sf-col" aria-label="Catalogue">
      <p class="sf-h">Catalogue</p>
      <a href="/search/">All offers</a>
      <a href="/brands/">Brands A–Z</a>
      <a href="/instant-quote/">Instant Quote</a>
    </nav>
    <nav class="sf-col" aria-label="Help">
      <p class="sf-h">Buying</p>
      <a href="/guides/requirement-list-format/">How to order</a>
      <a href="/guides/t1-vs-t2-duty-status/">T1 vs T2 explained</a>
      <a href="/guides/">All guides</a>
      <a href="/about/">About AKAY</a>
    </nav>
    <div class="sf-col">
      <p class="sf-h">Contact</p>
      <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a>
      <a href="mailto:offers@akay.ie">offers@akay.ie</a>
      <a href="mailto:hello@akay.ie">hello@akay.ie</a>
      <span>{companyAddressLine()}</span>
    </div>
  </div>
  <div class="sf-legal">
    <span>© {year} {LEGAL_NAME}</span>
    <span>Registered in Ireland · CRO {CRO_NUMBER}</span>
    <span>VAT {VAT_NUMBER}</span>
    <span><strong>T1</strong> = export / under bond · <strong>T2</strong> = duty-paid, for sale in the EU</span>
  </div>
</footer>

<style>
  .site-footer{border-top:1px solid var(--line);background:var(--paper-2);color:var(--muted);font-family:var(--sans);
    font-size:13px;line-height:1.6;margin-top:0}
  .sf-in{max-width:1200px;margin:0 auto;padding:34px 20px 22px;display:grid;gap:24px 32px;
    grid-template-columns:minmax(240px,2fr) repeat(3,minmax(140px,1fr));box-sizing:border-box}
  @media (max-width:820px){.sf-in{grid-template-columns:1fr 1fr}.sf-about{grid-column:1 / -1}}
  .sf-col{display:flex;flex-direction:column;gap:6px;min-width:0}
  .sf-col p{margin:0}
  .sf-about p:not(.sf-name){max-width:52ch}
  .sf-name{font-family:var(--serif);font-weight:600;font-size:20px;color:var(--ink);letter-spacing:.02em;margin-bottom:4px!important}
  .sf-name b{color:var(--brass)}
  .sf-h{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
  .sf-col a{color:var(--ink-soft);text-decoration:none}
  .sf-col a:hover{color:var(--brass);text-decoration:underline}
  .sf-legal{max-width:1200px;margin:0 auto;padding:14px 20px 30px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;
    gap:6px 22px;font-family:var(--mono);font-size:11.5px;box-sizing:border-box}
  .sf-legal strong{color:var(--ink-soft)}
</style>
